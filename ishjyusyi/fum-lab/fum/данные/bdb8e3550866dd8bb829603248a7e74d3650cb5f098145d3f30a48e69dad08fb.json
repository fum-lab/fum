v/following{/other_user}","gists_url":"https://api.github.com/users/Roman-Kerimov/gists{/gist_id}","starred_url":"https://api.github.com/users/Roman-Kerimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Roman-Kerimov/subscriptions","organizations_url":"https://api.github.com/users/Roman-Kerimov/orgs","repos_url":"https://api.github.com/users/Roman-Kerimov/repos","events_url":"https://api.github.com/users/Roman-Kerimov/events{/privacy}","received_events_url":"https://api.github.com/users/Roman-Kerimov/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2026-10-17T23:31:23Z","updated_at":"2026-10-17T23:31:59Z","closed_at":null,"assignee":{"login":"Roman-Kerimov","id":22149544,"node_id":"MDQ6VXNlcjIyMTQ5NTQ0","avatar_url":"https://avatars.githubusercontent.com/u/22149544?v=4","gravatar_id":"","url":"https://api.github.com/users/Roman-Kerimov","html_url":"https://github.com/Roman-Kerimov","followers_url":"https://api.github.com/users/Roman-Kerimov/followers","following_url":"https://api.github.com/users/Roman-Kerimov/following{/other_user}","gists_url":"https://api.github.com/users/Roman-Kerimov/gists{/gist_id}","starred_url":"https://api.github.com/users/Roman-Kerimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Roman-Kerimov/subscriptions","organizations_url":"https://api.github.com/users/Roman-Kerimov/orgs","repos_url":"https://api.github.com/users/Roman-Kerimov/repos","events_url":"https://api.github.com/users/Roman-Kerimov/events{/privacy}","received_events_url":"https://api.github.com/users/Roman-Kerimov/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**FUM Codex**\n\nВ принятом плане подготовки второго базиса найден цикл из 13 823 отдельных Git-вызовов: 6 913 проверок метаданных деревьев и 6 910 чтений их сырых байтов. Это 99,29% числа процессов наблюдённого PLAN4, а не измеренная доля времени. Ускорение полного пути пока не установлено.\n\nНужно заменить этот цикл ограниченным пакетным каналом и сохранить точные проверки OID, типа, размера, сырых байтов и протокола, а также существующие фазовые ограды и поздние сверки. Канал не должен читать содержимое до соответствующей ограды. Ошибки, обрывы, лишние ответы, тайм-аут и дрейф закрывают допуск.\n\nКритерии приёмки:\n\n- Различающие RED/GREEN, включая изменение объекта между проверкой метаданных и чтением содержимого, pack-объекты и повторные вызовы.\n- Парный профиль полного выбранного пути C5/C6 на сопоставимых входах с одинаковыми K/R/T и проверками результата; отдельно указать фоновые процессы и пределы вывода.\n- Счётчики каждого фактического канала с явным неполным покрытием прежнего os.read. Логические размеры объектов не выдаются за физический I/O.\n- Реальный APPLY4, его входы, состояние и отчётный контур остаются закреплёнными; новое исполнение использует отдельно принятый код.\n\nРеализация C6 уже назначена отдельному исполнителю. Поставка, ROOT-приёмка и интеграция остаются разными этапами.\n\nПлан и наблюдения: [исправленная постановка](https://github.com/fum-lab/fum/blob/6cdb75a2e0c44cfc7d1fe9770bc9817aeb5d6857/Планирование/доработки-автоматизаций/2026-10-18/пакетная-проверка-деревьев-и-покрытие-счётчиков-C38.json), [наблюдение профиля](https://github.com/fum-lab/fum/blob/6cdb75a2e0c44cfc7d1fe9770bc9817aeb5d6857/Планирование/наблюдения/2026-10-18/профиль-плана-базиса-и-границы-счётчиков-C38.json).\n\nСвязи: [#256 — создание коммита базиса без изменения проверенного дерева](https://github.com/fum-lab/fum/issues/256), [#301 — отдельный кэш проверки исторического Журнала](https://github.com/fum-lab/fum/issues/301), [#151 — аудит состояния узла и полных затрат](https://github.com/fum-lab/fum/issues/151).","closed_by":null,"reactions":{"url":"https://api.github.com/repos/fum-lab/fum/issues/338/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/fum-lab/fum/issues/338/timeline","performed_via_github_app":{"id":1144995,"client_id":"Iv23liVemv8A9if9v0F2","slug":"chatgpt-codex-connector","node_id":"A_kwHOAOQ6Gs4AEXij","owner":{"login":"openai","id":14957082,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE0OTU3MDgy","avatar_url":"https://avatars.githubusercontent.com/u/14957082?v=4","gravatar_id":"","url":"https://api.github.com/users/openai","html_url":"https://github.com/openai","followers_url":"https://api.github.com/users/openai/followers","following_url":"https://api.github.com/users/openai/following{/other_user}","gists_url":"https://api.github.com/users/openai/gists{/gist_id}","starred_url":"https://api.github.com/users/openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/openai/subscriptions","organizations_url":"https://api.github.com/users/openai/orgs","repos_url":"https://api.github.com/users/openai/repos","events_url":"https://api.github.com/users/openai/events{/privacy}","received_events_url":"https://api.github.com/users/openai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"ChatGPT Codex Connector","description":"Bring ChatGPT and Codex to your GitHub repositories.","external_url":"https://www.chatgpt.com","html_url":"https://github.com/apps/chatgpt-codex-connector","created_at":"2025-02-14T01:37:05Z","updated_at":"2026-09-23T18:52:59Z","permissions":{"actions":"write","checks":"read","contents":"write","emails":"read","issues":"write","metadata":"read","pull_requests":"write","statuses":"read","workflows":"write"},"events":["check_run","check_suite","commit_comment","issues","issue_comment","pull_request","pull_request_review","pull_request_revi