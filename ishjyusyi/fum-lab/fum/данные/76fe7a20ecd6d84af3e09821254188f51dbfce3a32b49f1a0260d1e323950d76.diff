+{
+  "schema": "fum.github-pr-snapshots.1",
+  "repository": "fum-lab/fum",
+  "number": 490,
+  "captured_at_utc": "2026-10-31T15:46:36Z",
+  "source": "connected GitHub tools; normalized responses",
+  "readback": {
+    "url": "https://github.com/fum-lab/fum/pull/490",
