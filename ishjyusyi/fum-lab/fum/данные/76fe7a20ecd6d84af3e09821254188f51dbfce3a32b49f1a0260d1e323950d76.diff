оверки() }\n             else { _ = try гит(план.корень, [\"mv\", \"--\", план.исходный, план.целевой]) }\n             перенесён = true\n+            try сохранитьРежимИндексаПослеПереноса(план)\n             for (номер, запись) in подготовленные.enumerated() {\n                 установленные.append(запись)\n                 try передУстановкой?(номер + 1)"
