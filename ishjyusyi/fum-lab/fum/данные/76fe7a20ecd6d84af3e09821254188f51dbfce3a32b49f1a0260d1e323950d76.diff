+        "patch": "@@ -425,14 +425,9 @@ enum ПереименованиеФайла {\n         let правка: ПравкаФайлаПереименования\n         let новая: URL\n         let резервная: URL\n+        let логическиеКопии: [Data]\n     }\n-    private static func сверитьПрименение(_ план: ПланПереименованияФайла) throws {\n-        let контекст = КонтекстЧтения()\n-        try проверитьПрефиксыЦелей(план.корень, план.локальныеЦели.map { Data($0.utf8) == Data(план.исходный.utf8) ? план.целевой : $0 })\n-        let состояниеИндекса = try СостояниеФайлаПереименования(план.адресИндекса)\n-        try требовать(состояниеИндекса.обычный && состояниеИндекса.режим & 0o7777 == план.режимИндекса, \"Дрейф типа или режима индекса после переноса\")\n-        try требовать(try гит(план.корень, [\"rev-parse\", \"--verify\", \"HEAD\"]) == план.голова, \"Дрейф HEAD после переноса\")\n-        try требовать(try гит(план.корень, [\"symbolic-ref\", \"-q\", \"HEAD\"], коды: [0, 1]) == план.ветка, \"Дрейф ref после переноса\")\n+    private static func сверитьДельтуИндекса(_ план: ПланПереименованияФайла) throws {\n         var записи: [(Data, Data)] = []\n         for запись in план.записиИндекса.split(separator: 0) {\n             guard let граница = запись.firstIndex(of: 9) else { throw ОшибкаПутей.отказ(\"Повреждённая stage-запись\") }\n@@ -442,6 +437,47 @@ enum ПереименованиеФайла {\n         }\n         let ожидание = записи.sorted { $0.0.lexicographicallyPrecedes($1.0) }.reduce(into: Data()) { $0.append($1.1) }\n         try требовать(try гит(план.корень, [\"ls-files\", \"--stage\", \"-z\"]) == ожидание, \"Неожиданная дельта Git-индекса после переноса\")\n+    }\n+    private static func сохранитьРежимИндексаПослеПереноса(_ план: ПланПереименованияФайла) throws {\n+        // Git создаёт новый индекс с учётом umask. После известного успешного mv\n+        // возвращаем прежний режим только проверенному узлу, не меняя umask.\n+        try сверитьДельтуИндекса(план)\n+        try требовать(try гит(план.корень, [\"rev-parse\", \"--verify\", \"HEAD\"]) == план.голова, \"Дрейф HEAD после переноса\")\n+        try требовать(try гит(план.корень, [\"symbolic-ref\", \"-q\", \"HEAD\"], коды: [0, 1]) == план.ветка, \"Дрейф ref после переноса\")\n+        let родитель = план.адресИндекса.deletingLastPathComponent()\n+        let состояниеРодителя = try СостояниеФайлаПереименования(родитель)\n+        try требовать(состояниеРодителя.каталог, \"Не реальный родитель индекса\")\n+        let байты = try прочитатьОбычный(план.адресИндекса, предел: 33_554_432)\n+        var прежде = stat(), внутри = stat(), после = stat(), именованный = stat(), замок = stat()\n+        try требовать(lstat(план.адресИндекса.path, &прежде) == 0 && прежде.st_mode & S_IFMT == S_IFREG\n+            && прежде.st_uid == geteuid() && прежде.st_nlink == 1, \"Не собственный обычный индекс\")\n+        let дескриптор = open(план.адресИндекса.path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC)\n+        try требовать(дескриптор >= 0, \"Не открыт индекс для сохранения режима\")\n+        defer { close(дескриптор) }\n+        try требовать(fstat(дескриптор, &внутри) == 0 && внутри.st_dev == прежде.st_dev && внутри.st_ino == прежде.st_ino\n+            && внутри.st_mode == прежде.st_mode && внутри.st_uid == прежде.st_uid && внутри.st_gid == прежде.st_gid\n+            && внутри.st_nlink == 1 && внутри.st_size == прежде.st_size, \"Дрейф FD индекса\")\n+        try требовать(lstat(план.адресИндекса.path + \".lock\", &замок) == -1 && errno == ENOENT, \"Индекс занят другим писателем\")\n+        try требовать(try СостояниеФайлаПереименования(родитель) == состояниеРодителя\n+            && прочитатьОбычный(план.адресИндекса, предел: 33_554_432) == байты, \"Дрейф индекса перед сохранением режима\")\n+        try требовать(fchmod(дескриптор, план.режимИндекса) == 0 && fsync(дескриптор) == 0, \"Не сохранён режим индекса\")\n+        try требовать(fstat(дескриптор, &после) == 0 && lstat(план.адресИндекса.path, &именованный) == 0\n+            && после.st_dev == прежде.st_dev && после.st_ino == прежде.st_ino && после.st_uid == прежде.st_uid\n+            && после.st_gid == прежде.st_gid && после.st_nlink == 1 && после.st_size == прежде.st_size\n+            && после.st_mode == S_IFREG | план.режимИндекса && именованный.st_dev == после.st_dev\n+            && именованный.st_ino == после.st_ino && именованный.st_mode == после.st_mode, \"Дрейф узла после сохранения режима\")\n+        try требовать(lstat(план.адресИндекса.path + \".lock\", &замок) == -1 && errno == ENOENT, \"Поздний писатель индекса\")\n+        try требовать(try СостояниеФайлаПереименования(родитель) == состояниеРодителя\n+            && прочитатьОбычный(план.адресИндекса, предел: 33_554_432) == байты, \"Дрейф байтов индекса при сохранении режима\")\n+    }\n+    private static func сверитьПрименение(_ план: ПланПереименованияФайла) throws {\n+        let контекст = КонтекстЧтения()\n+        try проверитьПрефиксыЦелей(план.корень, план.локальныеЦели.map { Data($0.utf8) == Data(план.исходный.utf8) ? план.целевой : $0 })\n+        let состояниеИндекса = try СостояниеФайлаПереименования(план.адресИндекса)\n+        try требовать(состояниеИндекса.обычный && состояниеИндекса.режим & 0o7777 == план.режимИндекса, \"Дрейф типа или режима индекса после переноса\")\n+        try требовать(try гит(план.корень, [\"rev-parse\", \"--verify\", \"HEAD\"]) == план.голова, \"Дрейф HEAD после переноса\")\n+        try требовать(try гит(план.корень, [\"symbolic-ref\", \"-q\", \"HEAD\"], коды: [0, 1]) == план.ветка, \"Дрейф ref после переноса\")\n+        try сверитьДельтуИндекса(план)\n         for файл in план.файлы {\n             let путь = Data(файл.путь.utf8) == Data(план.исходный.utf8) ? план.целевой : файл.путь\n             let текущий = try снимок(план.корень, путь, контекст: контекст)\n@@ -472,8 +508,10 @@ enum ПереименованиеФайла {\n             return ошибки\n         }\n         func статусБезСобственныхКопий() throws -> Data {\n-    