ing{/other_user}","gists_url":"https://api.github.com/users/Roman-Kerimov/gists{/gist_id}","starred_url":"https://api.github.com/users/Roman-Kerimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Roman-Kerimov/subscriptions","organizations_url":"https://api.github.com/users/Roman-Kerimov/orgs","repos_url":"https://api.github.com/users/Roman-Kerimov/repos","events_url":"https://api.github.com/users/Roman-Kerimov/events{/privacy}","received_events_url":"https://api.github.com/users/Roman-Kerimov/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2026-10-26T02:03:42Z","updated_at":"2026-10-26T02:03:42Z","closed_at":null,"assignee":{"login":"Roman-Kerimov","id":22149544,"node_id":"MDQ6VXNlcjIyMTQ5NTQ0","avatar_url":"https://avatars.githubusercontent.com/u/22149544?v=4","gravatar_id":"","url":"https://api.github.com/users/Roman-Kerimov","html_url":"https://github.com/Roman-Kerimov","followers_url":"https://api.github.com/users/Roman-Kerimov/followers","following_url":"https://api.github.com/users/Roman-Kerimov/following{/other_user}","gists_url":"https://api.github.com/users/Roman-Kerimov/gists{/gist_id}","starred_url":"https://api.github.com/users/Roman-Kerimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Roman-Kerimov/subscriptions","organizations_url":"https://api.github.com/users/Roman-Kerimov/orgs","repos_url":"https://api.github.com/users/Roman-Kerimov/repos","events_url":"https://api.github.com/users/Roman-Kerimov/events{/privacy}","received_events_url":"https://api.github.com/users/Roman-Kerimov/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**FUM Codex**\n\nПри RO-обзоре выделенных 13 предметных файлов генератора из `41a0140171841ddbd721325c7e15239393f4cc60` найден конкретный блокер применения к текущему FUM. В `proverka-manifesta.swift:11–12,30` имя каждой target проверяется как Swift-идентификатор. Уже принятая цель `proverki-aktualizaciya-putej` содержит дефисы и будет отклонена как «неверное-имя-модуля». Имя цели SwiftPM и идентификатор Swift-модуля — разные понятия; принятую цель ради ограничения генератора переименовывать не требуется.\n\nНужен ограниченный следующий срез в существующей линии генератора: различающий RED на точном имени действующей цели и соответствующей модели, исправление проверки без ослабления защиты строк/коллизий, GREEN и проверка полного `dump-package` на актуальном явно выбранном составе. Прежний пример модели C2 содержит четыре цели и пустые зависимости: применять его поверх ROOT нельзя, иначе будут потеряны Names и LinguisticKit. Окончательную модель согласовать с принятыми поставками batch9 и локального журнала.\n\nВыделенные 13 blobs/mode/size/SHA совпали с ROselector; старые Журналы, RAW и Python в выборку не входят. Эти факты ещё не являются ROOT-приёмкой, сборкой текущего FUM или разрешением установки старой модели. 28 тестовых функций и прежние успешные CLI-исходы относятся к ограниченному подмножеству той модели.\n\nСохранить один существующий product `fuma`. Подключение через общий CLI требует узкого публичного фасада; сейчас API internal, а условный @main и совместная компиляция тестов сами по себе не доказывают такое подключение. Все новые результаты и журнал — в области владельца; только Swift/FUMA, без новых Python-правок. Исполнитель получает поручение через непосредственного родителя Names. Пакетный перенос9 не останавливается ради этой доработки.\n\nГотовность: точный проверенный коммит, адресные RED/GREEN, полный состав текущей модели без потерь и заявленная граница подключения. RO-находка пока не объявляется исполненным тестом или исправлением.","closed_by":