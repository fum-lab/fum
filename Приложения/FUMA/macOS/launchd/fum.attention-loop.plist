<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>fum.attention-loop</string>
	<key>ProgramArguments</key>
	<array>
		<string>${FUM_BUILD_ROOT}/dist/fum-attention-loop</string>
		<string>--interval</string>
		<string>1</string>
		<string>--idle-seconds</string>
		<string>90</string>
	</array>
	<key>WorkingDirectory</key>
	<string>${FUM_RUNTIME_ROOT}</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>${FUM_RUNTIME_ROOT}/realtime/attention/stdout.log</string>
	<key>StandardErrorPath</key>
	<string>${FUM_RUNTIME_ROOT}/realtime/attention/stderr.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>FUM_RUNTIME_ROOT</key>
		<string>${FUM_RUNTIME_ROOT}</string>
		<key>FUM_MEMORY_ROOT</key>
		<string>${FUM_MEMORY_ROOT}</string>
	</dict>
</dict>
</plist>
