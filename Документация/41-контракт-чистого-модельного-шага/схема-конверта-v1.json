{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fum:pure-model-step:envelope:v1",
  "title": "Конверт чистого модельного шага FUM версии 1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "technical_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "model", "runtime"],
      "properties": {
        "kind": { "$ref": "#/$defs/technical_id" },
        "id": { "$ref": "#/$defs/technical_id" },
        "model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "runtime": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["system", "user", "assistant"] },
        "content": { "type": "string", "minLength": 1 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "invocation_id",
        "provider",
        "messages",
        "response_format",
        "limits",
        "capabilities"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "invocation_id": { "$ref": "#/$defs/technical_id" },
        "provider": { "$ref": "#/$defs/provider" },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/message" },
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": { "role": { "const": "user" } }
          }
        },
        "response_format": { "const": "text" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_output_bytes", "timeout_milliseconds"],
          "properties": {
            "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
            "timeout_milliseconds": { "type": "integer", "minimum": 1, "maximum": 300000 }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tools", "files", "network"],
          "properties": {
            "tools": { "const": false },
            "files": { "const": false },
            "network": { "const": false }
          }
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "invocation_id",
        "input_sha256",
        "provider",
        "status",
        "output",
        "metrics"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "invocation_id": { "$ref": "#/$defs/technical_id" },
        "input_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "provider": { "$ref": "#/$defs/provider" },
        "status": { "const": "completed" },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content", "finish_reason"],
          "properties": {
            "content": { "type": "string", "minLength": 1 },
            "finish_reason": { "const": "stop" }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_bytes", "output_bytes"],
          "properties": {
            "input_bytes": { "type": "integer", "minimum": 1 },
            "output_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "error"],
      "properties": {
        "schema_version": { "const": 1 },
        "invocation_id": { "$ref": "#/$defs/technical_id" },
        "status": { "const": "rejected" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "$ref": "#/$defs/technical_id" },
            "message": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
