{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fum:source-ingest:message:v1",
  "title": "Контракт первого продуктового URL-среза FUM версии 1",
  "description": "Строгие сообщения prepare, показанного плана, подтверждения, execute и результата для приёма одного публичного HTTPS HTML-источника.",
  "x-fum-contract-version": "fum.source-ingest.v1",
  "x-fum-entrypoints": [
    "fum.source.prepare.v1",
    "fum.source.show-plan.v1",
    "fum.source.confirm.v1",
    "fum.source.execute.v1",
    "fum.source.status.v1"
  ],
  "x-fum-canonical-json-profile": "fum.memory.canonical-json.v1",
  "x-fum-digest-rules": {
    "source_id": "SHA-256(UTF8('fum.source-url.identity.v1') || 0x00 || UTF8(canonical_url))",
    "address_policy_digest": "SHA-256(canonical JSON of the exact forbidden names, CIDRs, matching rules and unknown-range rule in x-fum-network-invariants)",
    "policy_digest": "SHA-256(canonical JSON network_policy without policy_digest)",
    "plan_digest": "SHA-256(canonical JSON prepared_plan without plan_digest)",
    "confirmation_digest": "SHA-256(canonical JSON confirmation without confirmation_digest)",
    "manifest_digest": "SHA-256(canonical JSON manifest without manifest_digest)",
    "edge_id": "SHA-256(canonical JSON provenance_edge without edge_id)",
    "record_id": "SHA-256(canonical JSON provenance_record without record_id and generation_id)",
    "protected_url_record_id": "SHA-256(canonical JSON protected_url_record without record_id)",
    "generation_id": "SHA-256(canonical JSON object containing operation_id, previous_generation_id, manifest_digest, provenance_record_id and trace_digest)"
  },
  "x-fum-url-canonicalization": {
    "profile": "fum.source-url.canonical.v1",
    "max_utf8_bytes": 4096,
    "scheme": "https-only-lowercase",
    "userinfo": "reject",
    "ip_literal": "reject",
    "port": "only-443-and-omit-from-canonical-form",
    "host": "ASCII-LDH-or-preencoded-A-label-lowercase-remove-one-terminal-dot-reject-non-ASCII-empty-single-label-and-label-edge-hyphen",
    "path": "empty-to-slash-remove-RFC3986-dot-segments-uppercase-percent-hex-decode-unreserved-reject-control-space-backslash",
    "query": "preserve-presence-order-duplicates-and-separators-uppercase-percent-hex-decode-unreserved-no-sorting",
    "fragment": "discard-value-before-durable-record-and-show-presence-only",
    "display_query": "replace-entire-query-with-query-sha256-and-first-16-lowercase-hex-digits",
    "redirect_identity": "source_id-always-derived-from-initial-canonical-url"
  },
  "x-fum-network-invariants": {
    "address_policy": "fum.public-address-space.v1",
    "all_dns_answers_must_be_global": true,
    "max_dns_answers_per_hop": 16,
    "resolve_each_redirect_hop": true,
    "pin_validated_address_to_connection": true,
    "peer_must_match_validated_set": true,
    "environment_proxy_and_pac": "disabled",
    "http3": "disabled",
    "dns_search_suffix": "disabled",
    "forbidden_host_suffixes": [
      "localhost",
      ".localhost",
      ".local",
      ".localdomain",
      ".internal",
      ".home.arpa",
      ".onion",
      ".invalid",
      ".test",
      ".example"
    ],
    "forbidden_metadata_names": [
      "metadata.google.internal",
      "instance-data.ec2.internal"
    ],
    "forbidden_ipv4_cidrs": [
      "0.0.0.0/8",
      "10.0.0.0/8",
      "100.64.0.0/10",
      "127.0.0.0/8",
      "169.254.0.0/16",
      "172.16.0.0/12",
      "192.0.0.0/24",
      "192.0.2.0/24",
      "192.88.99.0/24",
      "192.168.0.0/16",
      "198.18.0.0/15",
      "198.51.100.0/24",
      "203.0.113.0/24",
      "224.0.0.0/4",
      "240.0.0.0/4"
    ],
    "forbidden_ipv6_cidrs": [
      "::/128",
      "::1/128",
      "::ffff:0:0/96",
      "64:ff9b::/96",
      "64:ff9b:1::/48",
      "100::/64",
      "2001::/23",
      "2001:db8::/32",
      "2002::/16",
      "3fff::/20",
      "5f00::/16",
      "fc00::/7",
      "fe80::/10",
      "fec0::/10",
      "ff00::/8"
    ],
    "unknown_or_unclassified_special_range": "reject",
    "forbidden_host_matching": "exact-name-or-dot-suffix-at-label-boundary",
    "same_origin": "equal-canonical-ASCII-host-and-effective-port-443"
  },
  "x-fum-request-profile": {
    "method": "GET",
    "accept": "text/html",
    "accept_encoding": "identity",
    "forbidden_request_headers": [
      "Authorization",
      "Cookie",
      "Proxy-Authorization",
      "Referer"
    ],
    "redirect_response_body": "do-not-read",
    "automatic-credential-forwarding": "disabled"
  },
  "x-fum-cross-message-invariants": [
    "prepared_plan.operation_id equals prepare_request.operation_id",
    "prepared_plan.presentation fields equal the normative fields of the same prepared_plan",
    "confirmation operation_id, plan_id, nonce and both plan digests equal the shown prepared_plan",
    "confirmation.confirmed_at is not later than prepared_plan.expires_at",
    "prepared_plan.expires_at equals prepared_plan.prepared_at plus exactly 600 seconds",
    "prepared_plan.nonce contains at least 128 bits from a cryptographically secure source",
    "source_mode create has null expected_source_generation_id and update has a non-null digest",
    "display_url replaces an entire present query with query-sha256 plus the first 16 lowercase hex digits and never contains a fragment value",
    "execute_request operation_id equals both nested operation identifiers",
    "execute validates the exact current policy digest, scope revision, provenance revision and expected source generation before DNS and again before commit",
    "one confirmation is consumed at most once; status replay never performs a second fetch",
    "all source_id fields in one execution are equal",
    "success_result.previous_generation_id and commit_record.expected_generation_id equal prepared_plan.expected_source_generation_id",
    "manifest_digest and provenance_record_id in success, provenance and commit references are pairwise equal",
    "network_observation.protected_url_record_id identifies a protected_url_record in the same committed generation"
  ],
  "x-fum-transaction-invariants": [
    "snapshot manifest, protected URL record, provenance record and idempotent provenance edge become visible through one generation CAS",
    "no success exists with a visible snapshot and an absent provenance record or vice versa",
    "a failure result always leaves canonical_state_changed false",
    "a crash before generation CAS exposes no new generation",
    "a crash after generation CAS is recovered as the same successful operation without refetch"
  ],
  "x-fum-error-redaction": "error message and safe_details must not contain a full URL, query or fragment value, IP address, absolute path, credential or token",
  "x-fum-test-only-failpoints": [
    "after_confirmation_claim",
    "after_snapshot_staged",
    "after_provenance_staged",
    "before_generation_cas",
    "after_generation_cas"
  ],
  "x-fum-test-only-error-injections": [
    "manifest_write_error",
    "provenance_write_error",
    "generation_commit_error"
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/prepare_request"
    },
    {
      "$ref": "#/$defs/prepared_plan"
    },
    {
      "$ref": "#/$defs/confirmation"
    },
    {
      "$ref": "#/$defs/execute_request"
    },
    {
      "$ref": "#/$defs/execution_result"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullable_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,128}$"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://",
      "maxLength": 4096,
      "x-fum-max-utf8-bytes": 4096
    },
    "canonical_https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 4096,
      "x-fum-max-utf8-bytes": 4096
    },
    "permissions": {
      "type": "array",
      "prefixItems": [
        {
          "const": "source.read.public-https"
        },
        {
          "const": "memory.sources.write"
        },
        {
          "const": "provenance.link.write"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "excluded_capabilities": {
      "type": "array",
      "prefixItems": [
