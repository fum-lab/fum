нных примера путей. Полная готовность к слиянию ещё не объявлена.","created_at":"2026-10-08T02:44:01Z","updated_at":"2026-10-08T02:44:01Z","closed_at":null,"merged_at":null,"merge_commit_sha":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":true,"commits_url":"https://api.github.com/repos/fum-lab/fum/pulls/222/commits","review_comments_url":"https://api.github.com/repos/fum-lab/fum/pulls/222/comments","review_comment_url":"https://api.github.com/repos/fum-lab/fum/pulls/comments{/number}","comments_url":"https://api.github.com/repos/fum-lab/fum/issues/222/comments","statuses_url":"https://api.github.com/repos/fum-lab/fum/statuses/208a9475b1646b942c664caf822b845264155b16","head":{"label":"fum-lab:codex/dir/instrumentyi--fum-svyaznostj-rabochej-sessii--0165","ref":"codex/dir/instrumentyi--fum-svyaznostj-rabochej-sessii--0165","sha":"208a9475b1646b942c664caf822b845264155b16","user":{"login":"fum-lab","id":298648657,"node_id":"O_kgDOEc0EUQ","avatar_url":"https://avatars.githubusercontent.com/u/298648657?v=4","gravatar_id":"","url":"https://api.github.com/users/fum-lab","html_url":"https://github.com/fum-lab","followers_url":"https://api.github.com/users/fum-lab/followers","following_url":"https://api.github.com/users/fum-lab/following{/other_user}","gists_url":"https://api.github.com/users/fum-lab/gists{/gist_id}","starred_url":"https://api.github.com/users/fum-lab/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fum-lab/subscriptions","organizations_url":"https://api.github.com/users/fum-lab/orgs","repos_url":"https://api.github.com/users/fum-lab/repos","events_url":"https://api.github.com/users/fum-lab/events{/privacy}","received_events_url":"https://api.github.com/users/fum-lab/received_events","type":"Organization","user_view_type":"public","site_admin":false},"repo":{"id":1285958028,"node_id":"R_kgDOTKYpjA","name":"fum","full_name":"fum-lab/fum","private":false,"owner":{"login":"fum-lab",