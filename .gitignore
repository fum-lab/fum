.DS_Store
__pycache__/
*.py[cod]

# Локальные продукты сборки SwiftPM не являются памятью проекта.
.build/
.swiftpm/

# Физические checkout переиспользуемого локального пула worktree не являются канонической памятью.
/Подузлы/

# Сырые события клавиатуры игнорируются по умолчанию; проверенный сеанс для существенного вывода добавляется только точным `git add -f`.
/Прототипы/физические-состояния-клавиш/Локальные-данные-прогонов/

# Весь корневой каталог Obsidian является локальным состоянием и не входит в Git-память проекта.
/.obsidian/
