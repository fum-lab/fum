{
  "схема": "fum.определение-оператора.2",
  "идентификатор": "синтетический-спектр-четырёх-отсчётов",
  "версия": 1,
  "правила": [],
  "шаги": [
    {
      "идентификатор": "вычислить-признаки",
      "оператор": "вычислить-JSON",
      "аргументы": {
        "граф": {
          "схема": "fuma.граф-JSON.2",
          "числа": "целые64-без-дробей",
          "переменные": [
            {"имя": "окно", "значение": ["путь", ["переменная", "вход"], "отсчёты"]},
            {"имя": "длина-окна", "значение": ["потребовать-диапазон", ["длина", ["переменная", "окно"]], 4, 4]},
            {"имя": "а", "значение": ["потребовать-диапазон", ["путь", ["переменная", "окно"], 0], -1000, 1000]},
            {"имя": "б", "значение": ["потребовать-диапазон", ["путь", ["переменная", "окно"], 1], -1000, 1000]},
            {"имя": "в", "значение": ["потребовать-диапазон", ["путь", ["переменная", "окно"], 2], -1000, 1000]},
            {"имя": "г", "значение": ["потребовать-диапазон", ["путь", ["переменная", "окно"], 3], -1000, 1000]},
            {"имя": "вещественная-1", "значение": ["сложить", ["переменная", "а"], ["умножить", -1, ["переменная", "в"]]]},
            {"имя": "мнимая-1", "значение": ["сложить", ["переменная", "г"], ["умножить", -1, ["переменная", "б"]]]}
          ],
          "результат": {
            "состояние": "синтетическое-окно",
            "длина": ["переменная", "длина-окна"],
            "суммаКвадратов": ["сложить", ["сложить", ["умножить", ["переменная", "а"], ["переменная", "а"]], ["умножить", ["переменная", "б"], ["переменная", "б"]]], ["сложить", ["умножить", ["переменная", "в"], ["переменная", "в"]], ["умножить", ["переменная", "г"], ["переменная", "г"]]]],
            "вещественнаяК1": ["переменная", "вещественная-1"],
            "мнимаяК1": ["переменная", "мнимая-1"],
            "мощностьК1": ["сложить", ["умножить", ["переменная", "вещественная-1"], ["переменная", "вещественная-1"]], ["умножить", ["переменная", "мнимая-1"], ["переменная", "мнимая-1"]]]
          }
        }
      }
    },
    {
      "идентификатор": "сопоставить-учебные-эталоны",
      "оператор": "вычислить-JSON",
      "аргументы": {
        "граф": {
          "схема": "fuma.граф-JSON.2",
          "числа": "целые64-без-дробей",
          "переменные": [
            {"имя": "энергия", "значение": ["потребовать-диапазон", ["путь", ["переменная", "вход"], "суммаКвадратов"], 0, 4000000]},
            {"имя": "мощность", "значение": ["потребовать-диапазон", ["путь", ["переменная", "вход"], "мощностьК1"], 0, 8000000]}
          ],
          "результат": {
            "наблюдение": ["переменная", "вход"],
            "сопоставление": ["если",
              ["равно", ["массив", ["переменная", "энергия"], ["переменная", "мощность"]], ["массив", 1, 1]],
              {"статус": "один-учебный-эталон", "кандидаты": ["массив", "эталон-а"]},
              ["если",
                ["равно", ["массив", ["переменная", "энергия"], ["переменная", "мощность"]], ["массив", 2, 4]],
                {"статус": "неоднозначно", "кандидаты": ["массив", "эталон-б", "эталон-в"]},
                {"статус": "неизвестно", "кандидаты": ["массив"]}
              ]
            ]
          }
        }
      }
    }
  ],
  "определения": []
}
