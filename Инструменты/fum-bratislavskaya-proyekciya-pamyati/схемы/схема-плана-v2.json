{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "План братиславской проекции памяти FUM версии 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "схема",
    "хэш_плана",
    "исходный_снимок",
    "хэш_политики",
    "исходная_область",
    "производное_пространство",
    "целевая_область",
    "корень_файлов",
    "путь_манифеста",
    "исключённые_префиксы",
    "преобразование",
    "форматная_политика",
    "пустые_каталоги",
    "полный_инвентарь",
    "записи",
    "итоговые_целевые_пути",
    "состояние"
  ],
  "properties": {
    "схема": {
      "const": "fum.план-братиславской-проекции.2"
    },
    "хэш_плана": {
      "$ref": "#/$defs/хэш"
    },
    "исходный_снимок": {
      "$ref": "#/$defs/исходный_снимок"
    },
    "хэш_политики": {
      "$ref": "#/$defs/хэш"
    },
    "исходная_область": {
      "const": "."
    },
    "производное_пространство": {
      "const": "Proyekcii"
    },
    "целевая_область": {
      "const": "Proyekcii/Bratislavskaya-pamyatj"
    },
    "корень_файлов": {
      "const": "Proyekcii/Bratislavskaya-pamyatj/fajlyi"
    },
    "путь_манифеста": {
      "const": "Proyekcii/Bratislavskaya-pamyatj/manifest-proiskhozhdeniya-v2.json"
    },
    "исключённые_префиксы": {
      "const": [
        ".git",
        "Подузлы",
        "Proyekcii"
      ]
    },
    "преобразование": {
      "$ref": "#/$defs/преобразование"
    },
    "форматная_политика": {
      "$ref": "#/$defs/форматная_политика"
    },
    "пустые_каталоги": {
      "const": "не_включаются_в_инвентарь_репозитория"
    },
    "полный_инвентарь": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/инвентарная_запись"
      }
    },
    "записи": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/запись_плана"
      }
    },
    "итоговые_целевые_пути": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^Proyekcii/Bratislavskaya-pamyatj/fajlyi/.+"
      }
    },
    "состояние": {
      "const": "готов_без_записи"
    }
  },
  "$defs": {
    "хэш": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "OID": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "режим": {
      "enum": [
        "100644",
        "100755",
        "120000",
        "160000"
      ]
    },
    "исходный_снимок": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "хэш_инвентаря",
        "хэш_политики"
      ],
      "properties": {
        "хэш_инвентаря": {
          "$ref": "#/$defs/хэш"
        },
        "хэш_политики": {
          "$ref": "#/$defs/хэш"
        }
      }
    },
    "преобразование": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ревизия",
        "исходная_письменность",
        "целевая_письменность",
        "таблица",
        "метод"
      ],
      "properties": {
        "ревизия": {
          "const": "837e2ce107b97ee7b9d3344c9fe99142281fe393"
        },
        "исходная_письменность": {
          "const": "Cyrl"
        },
        "целевая_письменность": {
          "const": "Latn"
        },
        "таблица": {
          "const": "ru"
        },
        "метод": {
          "const": "applyingTransform"
        }
      }
    },
    "массив_строк": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "форматная_политика": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "разметка",
        "разметка_с_дословным_блоком",
        "дословные_источники",
        "код",
        "машинные_данные",
        "прочие_точные_форматы",
        "машинные_шаблоны",
        "двоичные_и_нетекстовые"
      ],
      "properties": {
        "разметка": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "расширения",
            "действие",
            "локальные_ссылки",
            "исключённые_локальные_цели",
            "якоря",
            "внешние_адреса",
            "FUM-MD-RECENCY"
          ],
          "properties": {
            "расширения": {
              "const": [
                ".md"
              ]
            },
            "действие": {
              "const": "преобразовать_структурно"
            },
            "локальные_ссылки": {
              "const": "перенаправить_в_поколение"
            },
            "исключённые_локальные_цели": {
              "const": "сохранить_ссылку_на_канонический_слой"
            },
            "якоря": {
              "const": "преобразовать_и_проверить"
            },
            "внешние_адреса": {
              "const": "сохранить"
            },
            "FUM-MD-RECENCY": {
              "const": "пересчитать_без_изменения_last-content-edit"
            }
          }
        },
        "разметка_с_дословным_блоком": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "шаблоны",
            "заголовок_начала",
            "действие"
          ],
          "properties": {
            "шаблоны": {
              "const": [
                "Журнал/*/запрос.md"
              ]
            },
            "заголовок_начала": {
              "const": "## Текст запроса"
            },
            "действие": {
              "const": "преобразовать_разметку_с_дословным_блоком"
            }
          }
        },
        "дословные_источники": {
          "$ref": "#/$defs/формат_по_шаблонам"
        },
        "код": {
          "$ref": "#/$defs/формат_кода"
        },
        "машинные_данные": {
          "$ref": "#/$defs/формат_машинных_данных"
        },
        "прочие_точные_форматы": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "расширения",
            "точные_пути",
            "действие"
          ],
          "properties": {
            "расширения": {
              "const": [
                ".txt",
                ".html",
                ".base64",
                ".mlir",
                ".css"
              ]
            },
            "точные_пути": {
              "const": [
                ".gitignore",
                ".gitmodules",
                ".obsidian/fum-recency-reference-date",
                "LICENSE",
                "fum",
                "ЛИЦЕНЗИЯ"
              ]
            },
            "действие": {
              "const": "сохранить_байты"
            }
          }
        },
        "машинные_шаблоны": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "окончания",
            "действие"
          ],
          "properties": {
            "окончания": {
              "const": [
                ".md.шаблон"
              ]
            },
            "действие": {
              "const": "сохранить_байты"
            }
          }
        },
        "двоичные_и_нетекстовые": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "действие"
          ],
          "properties": {
            "действие": {
              "const": "сохранить_байты"
            }
          }
        }
      }
    },
    "формат_по_шаблонам": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "шаблоны",
        "действие"
      ],
      "properties": {
        "шаблоны": {
          "const": [
            "Источники/**"
          ]
        },
        "действие": {
          "const": "сохранить_байты"
        }
      }
    },
    "формат_кода": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "расширения",
        "действие"
      ],
      "properties": {
        "расширения": {
          "const": [
            ".py",
            ".swift",
            ".sh"
          ]
        },
        "действие": {
          "const": "сохранить_байты"
        }
      }
    },
    "формат_машинных_данных": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "расширения",
        "действие"
      ],
      "properties": {
        "расширения": {
          "const": [
            ".json",
            ".jsonl",
            ".toml",
            ".yaml",
            ".yml",
            ".canvas",
            ".lock"
          ]
        },
        "действие": {
          "const": "сохранить_байты"
        }
      }
    },
    "инвентарная_запись": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "исходный_путь",
        "тип",
        "режим",
        "режим_индекса",
        "состояние_репозитория",
        "идентификатор_объекта_репозитория",
        "состояние",
        "причина",
        "входит_в_исходный_снимок",
        "размер_источника",
        "хэш_источника"
      ],
      "properties": {
        "исходный_путь": {
          "type": "string",
          "minLength": 1
        },
        "тип": {
          "enum": [
            "обычный_файл",
            "символическая_ссылка",
            "ссылка_на_вложенный_репозиторий"
          ]
        },
        "режим": {
          "$ref": "#/$defs/режим"
        },
        "режим_индекса": {
          "oneOf": [
            {
              "$ref": "#/$defs/режим"
            },
            {
              "type": "null"
            }
          ]
        },
        "состояние_репозитория": {
          "enum": [
            "отслеживаемый",
            "новый"
          ]
        },
        "идентификатор_объекта_репозитория": {
          "oneOf": [
            {
              "$ref": "#/$defs/OID"
            },
            {
              "type": "null"
            }
          ]
        },
        "состояние": {
          "enum": [
            "включён",
            "исключён"
          ]
        },
        "причина": {
          "type": "string",
          "minLength": 1
        },
        "входит_в_исходный_снимок": {
          "type": "boolean"
        },
        "размер_источника": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "хэш_источника": {
          "oneOf": [
            {
              "$ref": "#/$defs/хэш"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "компонент_пути": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "исходный",
        "целевая_основа",
        "сохранённое_расширение",
        "целевой",
        "изменён"
      ],
      "properties": {
        "исходный": {
          "type": "string",
          "minLength": 1
        },
        "целевая_основа": {
          "type": "string",
          "minLength": 1
        },
        "сохранённое_расширение": {
          "type": "string"
        },
        "целевой": {
          "type": "string",
          "minLength": 1
        },
        "изменён": {
          "type": "boolean"
        }
      }
    },
    "запись_плана": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "исходный_путь",
        "целевой_путь",
        "компоненты_пути",
        "тип",
        "режим",
        "режим_индекса",
        "состояние_репозитория",
        "идентификатор_объекта_репозитория",
        "размер_источника",
        "хэш_источника",
        "класс_содержимого",
        "действие_содержимого",
        "причина_действия",
        "хэш_цели"
      ],
      "properties": {
        "исходный_путь": {
          "type": "string",
          "minLength": 1
        },
        "целевой_путь": {
          "type": "string",
          "pattern": "^Proyekcii/Bratislavskaya-pamyatj/fajlyi/.+"
        },
        "компоненты_пути": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/компонент_пути"
          }
        },
        "тип": {
          "const": "обычный_файл"
        },
        "режим": {
          "enum": [
            "100644",
            "100755"
          ]
        },
        "режим_индекса": {
          "oneOf": [
            {
              "enum": [
                "100644",
                "100755"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "состояние_репозитория": {
          "enum": [
            "отслеживаемый",
            "новый"
          ]
        },
        "идентификатор_объекта_репозитория": {
          "oneOf": [
            {
              "$ref": "#/$defs/OID"
            },
            {
              "type": "null"
            }
          ]
        },
        "размер_источника": {
          "type": "integer",
          "minimum": 0
        },
        "хэш_источника": {
          "$ref": "#/$defs/хэш"
        },
        "класс_содержимого": {
          "type": "string",
          "minLength": 1
        },
        "действие_содержимого": {
          "enum": [
            "преобразовать_структурно",
            "преобразовать_разметку_с_дословным_блоком",
            "сохранить_байты"
          ]
        },
        "причина_действия": {
          "type": "string",
          "minLength": 1
        },
        "хэш_цели": {
          "type": "null"
        }
      }
    }
  }
}
