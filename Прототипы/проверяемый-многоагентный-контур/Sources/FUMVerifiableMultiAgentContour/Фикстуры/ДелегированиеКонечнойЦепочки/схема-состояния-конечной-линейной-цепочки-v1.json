            "поколение_очереди": { "$ref": "#/$defs/%D0%B8%D0%B4%D0%B5%D0%BD%D1%82%D0%B8%D1%84%D0%B8%D0%BA%D0%B0%D1%82%D0%BE%D1%80" },
            "базовая_вершина": { "$ref": "#/$defs/%D0%BE%D0%B1%D1%8A%D0%B5%D0%BA%D1%82_%D0%B3%D0%B8%D1%82" },
            "хэш_свидетельства": { "$ref": "#/$defs/%D1%85%D1%8D%D1%88" }
          }
        },
        "текущая_вершина": { "$ref": "#/$defs/%D0%BE%D0%B1%D1%8A%D0%B5%D0%BA%D1%82_%D0%B3%D0%B8%D1%82" },
        "идентификатор_физической_рабочей_копии": { "$ref": "#/$defs/%D0%B8%D0%B4%D0%B5%D0%BD%D1%82%D0%B8%D1%84%D0%B8%D0%BA%D0%B0%D1%82%D0%BE%D1%80" },
        "рабочая_ссылка": { "$ref": "#/$defs/%D1%81%D1%81%D1%8B%D0%BB%D0%BA%D0%B0_%D0%B2%D0%B5%D1%82%D0%BA%D0%B8" }
      }
    },
    "очередь": {
      "type": "object",
      "additionalProperties": false,
      "required": ["идентификатор_эпохи_очереди", "рабочая_ссылка", "идентификатор_физической_рабочей_копии", "строгий_порядок", "последний_порядок_допуска", "хэш_снимка"],
      "properties": {
        "идентификатор_эпохи_очереди": { "$ref": "#/$defs/%D0%B8%D0%B4%D0%B5%D0%BD%D1%82%D0%B8%D1%84%D0%B8%D0%BA%D0%B0%D1%82%D0%BE%D1%80" },
        "рабочая_ссылка": { "$ref": "#/$defs/%D1%81%D1%81%D1%8B%D0%BB%D0%BA%D0%B0_%D0%B2%D0%B5%D1%82%D0%BA%D0%B8" },
        "идентификатор_физической_рабочей_копии": { "$ref": "#/$defs/%D0%B8%D0%B4%D0%B5%D0%BD%D1%82%D0%B8%D1%84%D0%B8%D0%BA%D0%B0%D1%82%D0%BE%D1%80" },
        "строгий_порядок": { "const": true },
        "последний_порядок_допуска": { "type": "integer", "minimum": 0 },
        "хэш_снимка": { "$ref": "#/$defs/%D1%85%D1%8D%D1%88" }
      }
    },
    "состояние_диапазона": { "enum": ["назначен", "в_работе", "остановлен", "готов", "завершён_без_коммита", "отклонён"] },
    "внешние_задачи": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["вид", "идентификатор"],
        "properties": {
          "вид": { "enum": ["проверяющая", "интеграционная"] },
          "идентификатор": { "$ref": "#/$defs/%D0%B8%D0%B4%D0%B5%D0%BD%D1%82%D0%B8%D1%84%D0%B8%D0%BA%D0%B0%D1%82%D0%BE%D1%80" }
        }
      }
    },
    "принятие": {
      "type": "object",
      "additionalProperties": false,
      "required": ["состояние"],
      "properties": {
        "состояние": { "enum": ["не_решено", "вся_цепочка", "точный_префикс", "отклонено"] },
        "последняя_карточка": { "$ref": "#/$defs/%D0%B8%D0%B4%D0%B5%D0%BD%D1%82%D0%B8%D1%84%D0%B8%D0%BA%D0%B0%D1%82%D0%BE%D1%80" },
        "вершина": { "$ref": "#/$defs/%D0%BE%D0%B1%D1%8A%D0%B5%D0%BA%D1%82_%D0%B3%D0%B8%D1%82" }
      },
      "oneOf": [
        {
          "properties": { "состояние": { "const": "не_решено" } },
          "not": { "anyOf": [{ "required": ["последняя_карточка"] }, { "required": ["вершина"] }] }
        },
        {
          "properties": { "состояние": { "const": "вся_цепочка" } },
          "required": ["вершина"],
          "not": { "required": ["последняя_карточка"] }
        },
        {
          "properties": { "состояние": { "const": "точный_префикс" } },
          "required": ["последняя_карточка", "вершина"]
        },
        {
          "properties": { "состояние": { "const": "отклонено" } },
          "required": ["вершина"],
          "not": { "required": ["последняя_карточка"] }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "принятие": {
            "properties": {
              "состояние": { "enum": ["вся_цепочка", "точный_префикс", "отклонено"] }
            },
            "required": ["состояние"]
          }
        },
        "required": ["принятие"]
      },
      "then": {
        "properties": { "состояние_диапазона": { "const": "готов" } }
      }
    },
    {
      "if": {
        "properties": {
          "состояние_диапазона": { "enum": ["остановлен", "завершён_без_коммита", "отклонён"] }
        },
        "required": ["состояние_диапазона"]
      },
      "then": { "required": ["завершение_без_коммита"] },
      "else": { "not": { "required": ["завершение_без_коммита"] } }
    }
  ],
  "$defs": {
    "идентификатор": { "type": "string", "minLength": 1, "maxLength": 240 },
    "хэш": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "объект_гит": {
      "type": "string",
      "oneOf": [{ "pattern": "^[0-9a-f]{40}$" }, { "pattern": "^[0-9a-f]{64}$" }]
    },
    "ссылка_ветки": { "type": "string", "maxLength": 1024, "pattern": "^refs/heads/(?!@$)(?!\\.)(?!.*[/]\\.)(?![^/]*\\.lock(?:/|$))(?!.*[/][^/]*\\.lock(?:/|$))(?!.*\\.\\.)(?!.*@\\{)(?!.*[\\u0000-\\u0020\\u007F~^:?*\\[\\\\])(?!.*\\.$)[^/]+(?:/[^/]+)*$" },
    "относительный_путь": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!~)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\)(?!\\.{1,2}(?:/|$))(?!.*[/]\\.{1,2}(?:/|$))(?!.*[\\u0000-\\u001F\\u007F])[^/]+(?:/[^/]+)*$" },
    "список_идентификаторов": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/%D0%B8%D0%B4%D0%B5%D0%BD%D1%82%D0%B8%D1%84%D0%B8%D0%BA%D0%B0%D1%82%D0%BE%D1%80" }
    },
    "бюджет": {
      "type": "object",
      "additionalProperties": false,
      "required": ["токены", "секунды", "изменённые_файлы"],
      "properties": {
        "токены": { "type": "integer", "minimum": 0 },
        "секунды": { "type": "integer", "minimum": 0 },
        "изменённые_файлы": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
