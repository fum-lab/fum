{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fum:%D0%BF%D0%B0%D1%81%D0%BF%D0%BE%D1%80%D1%82-%D0%BA%D0%BE%D1%80%D0%BD%D0%B5%D0%B2%D0%BE%D0%B3%D0%BE-%D1%80%D0%B5%D0%B2%D1%8C%D1%8E-%D1%86%D0%B5%D0%BF%D0%BE%D1%87%D0%BA%D0%B8:v1",
  "title": "Паспорт корневого ревью цепочки v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "идентификатор",
    "поколениеНазначения",
    "проверяющий",
    "поставщик",
    "интегратор",
    "маршрут",
    "исходныйРепозиторий",
    "целевойРепозиторий",
    "каноническийПутьИсходногоРепозитория",
    "каноническийПутьЦелевогоРепозитория",
    "исходнаяСсылка",
    "целеваяСсылка",
    "база",
    "вершина",
    "коммиты",
    "хэшиЧастныхПаспортов",
    "хэшКритериев",
    "первоначальныеПроверки",
    "повторныеПроверки",
    "замечания",
    "группыКорреляции",
    "исход"
  ],
  "properties": {
    "идентификатор": { "$ref": "#/$defs/идентификатор" },
    "поколениеНазначения": { "$ref": "#/$defs/идентификатор" },
    "проверяющий": { "$ref": "#/$defs/идентификатор" },
    "поставщик": { "$ref": "#/$defs/идентификатор" },
    "интегратор": { "$ref": "#/$defs/идентификатор" },
    "маршрут": {
      "enum": [
        "собственный_результат_ребёнка",
        "проектный_результат",
        "общий_вклад_в_ядро"
      ]
    },
    "исходныйРепозиторий": { "$ref": "#/$defs/идентификатор" },
    "целевойРепозиторий": { "$ref": "#/$defs/идентификатор" },
    "каноническийПутьИсходногоРепозитория": { "$ref": "#/$defs/каноническийПуть" },
    "каноническийПутьЦелевогоРепозитория": { "$ref": "#/$defs/каноническийПуть" },
    "исходнаяСсылка": { "$ref": "#/$defs/полнаяСсылка" },
    "целеваяСсылка": { "$ref": "#/$defs/полнаяСсылка" },
    "база": { "$ref": "#/$defs/объектГит" },
    "вершина": { "$ref": "#/$defs/объектГит" },
    "коммиты": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/коммит" }
    },
    "хэшиЧастныхПаспортов": { "$ref": "#/$defs/непустойСписокХэшей" },
    "хэшКритериев": { "$ref": "#/$defs/хэш" },
    "первоначальныеПроверки": { "$ref": "#/$defs/непустойСписокХэшей" },
    "повторныеПроверки": { "$ref": "#/$defs/непустойСписокХэшей" },
    "замечания": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/замечание" }
    },
    "группыКорреляции": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/идентификатор" }
    },
    "исход": {
      "enum": ["принято", "на_доработку", "отклонено", "неопределённо"]
    }
  },
  "$defs": {
    "идентификатор": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!\\u007E)(?!\\.{1,2}$)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*[\\\\/])[^\\u0000-\\u001F\\u007F\\s]{1,240}$"
    },
    "хэш": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "объектГит": {
      "type": "string",
      "oneOf": [
        { "pattern": "^[0-9a-f]{40}$" },
        { "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "полнаяСсылка": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^refs/(?!@$)(?!\\.)(?!.*[/]\\.)(?![^/]*\\.lock(?:/|$))(?!.*[/][^/]*\\.lock(?:/|$))(?!.*\\.\\.)(?!.*@\\{)(?!.*[\\u0000-\\u0020\\u007F\\u007E^:?*\\[\\\\])(?!.*\\.$)[^/]+(?:/[^/]+)+$"
    },
    "каноническийПуть": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001F\\u007F])[^/]+(?:/[^/]+)*$"
    },
    "относительныйПуть": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!~)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\)(?!\\.{1,2}(?:/|$))(?!.*[/]\\.{1,2}(?:/|$))(?!.*[\\u0000-\\u001F\\u007F])[^/]+(?:/[^/]+)*/?$"
    },
    "содержательныйТекст": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^(?=.*\\S)[\\s\\S]{1,8192}$"
    },
    "непустойСписокХэшей": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/хэш" }
    },
    "коммит": {
      "type": "object",
      "additionalProperties": false,
      "required": ["объект", "родители"],
      "properties": {
        "объект": { "$ref": "#/$defs/объектГит" },
        "родители": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/объектГит" }
        }
      }
    },
    "замечание": {
      "type": "object",
      "additionalProperties": false,
      "required": ["код", "путь", "сообщение", "группаКорреляции"],
      "properties": {
        "код": { "$ref": "#/$defs/идентификатор" },
        "путь": { "$ref": "#/$defs/относительныйПуть" },
        "сообщение": { "$ref": "#/$defs/содержательныйТекст" },
        "группаКорреляции": { "$ref": "#/$defs/идентификатор" }
      }
    }
  }
}
