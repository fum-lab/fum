{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fum:schema:moderator-decision:v1",
  "title": "Решение родительского модератора v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "поколение_схемы",
    "идентификатор_решения",
    "хэш_решения",
    "идентификатор_дерева",
    "идентификатор_поколения",
    "идентификатор_родителя",
    "идентификатор_модератора",
    "идентификатор_попытки_модерации",
    "хэш_паспорта",
    "результаты",
    "базы",
    "вершины",
    "ссылки_результатов",
    "хэш_критериев",
    "идентификатор_родительского_репозитория",
    "родительская_рабочая_ссылка",
    "целевая_ссылка_интеграции",
    "ожидаемая_база",
    "исход",
    "хэши_свидетельств",
    "группы_корреляции",
    "граф_интеграции"
  ],
  "properties": {
    "поколение_схемы": { "const": 1 },
    "идентификатор_решения": { "$ref": "#/$defs/идентификатор" },
    "хэш_решения": { "$ref": "#/$defs/хэш" },
    "идентификатор_дерева": { "$ref": "#/$defs/идентификатор" },
    "идентификатор_поколения": { "$ref": "#/$defs/идентификатор" },
    "идентификатор_родителя": { "$ref": "#/$defs/идентификатор" },
    "идентификатор_модератора": { "$ref": "#/$defs/идентификатор" },
    "идентификатор_попытки_модерации": { "$ref": "#/$defs/идентификатор" },
    "хэш_паспорта": { "$ref": "#/$defs/хэш" },
    "результаты": { "$ref": "#/$defs/парные_хэши" },
    "базы": { "$ref": "#/$defs/парные_вершины" },
    "вершины": { "$ref": "#/$defs/парные_вершины" },
    "ссылки_результатов": { "$ref": "#/$defs/парные_ссылки" },
    "хэш_критериев": { "$ref": "#/$defs/хэш" },
    "идентификатор_родительского_репозитория": { "$ref": "#/$defs/идентификатор" },
    "родительская_рабочая_ссылка": { "$ref": "#/$defs/рабочая_ссылка" },
    "целевая_ссылка_интеграции": { "$ref": "#/$defs/рабочая_ссылка" },
    "ожидаемая_база": { "$ref": "#/$defs/git_объект" },
    "исход": {
      "enum": [
        "выбран_левый_результат",
        "выбран_правый_результат",
        "совместимое_объединение",
        "доработка_в_новом_поколении_назначения",
        "отклонены_оба",
        "неопределённость"
      ]
    },
    "хэши_свидетельств": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/хэш" }
    },
    "группы_корреляции": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/группа_корреляции" }
    },
    "граф_интеграции": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ребро_интеграции" }
    }
  },
  "$defs": {
    "идентификатор": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!\\u007E)(?!\\.{1,2}$)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*[\\\\/])[^\\u0000-\\u001F\\u007F]{1,240}$"
    },
    "хэш": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_объект": {
      "type": "string",
      "oneOf": [
        { "pattern": "^[0-9a-f]{40}$" },
        { "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "рабочая_ссылка": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^refs/heads/(?!@$)(?!\\.)(?!.*[/]\\.)(?![^/]*\\.lock(?:/|$))(?!.*[/][^/]*\\.lock(?:/|$))(?!.*\\.\\.)(?!.*@\\{)(?!.*[\\u0000-\\u0020\\u007F\\u007E^:?*\\[\\\\])(?!.*\\.$)[^/]+(?:/[^/]+)*$"
    },
    "парные_хэши": {
      "type": "object",
      "additionalProperties": false,
      "required": ["левый", "правый"],
      "properties": {
        "левый": { "$ref": "#/$defs/хэш" },
        "правый": { "$ref": "#/$defs/хэш" }
      }
    },
    "парные_вершины": {
      "type": "object",
      "additionalProperties": false,
      "required": ["левая", "правая"],
      "properties": {
        "левая": { "$ref": "#/$defs/git_объект" },
        "правая": { "$ref": "#/$defs/git_объект" }
      }
    },
    "парные_ссылки": {
      "type": "object",
      "additionalProperties": false,
      "required": ["левая", "правая"],
      "properties": {
        "левая": { "$ref": "#/$defs/рабочая_ссылка" },
        "правая": { "$ref": "#/$defs/рабочая_ссылка" }
      }
    },
    "группа_корреляции": {
      "type": "object",
      "additionalProperties": false,
      "required": ["идентификатор", "хэши_свидетельств"],
      "properties": {
        "идентификатор": { "$ref": "#/$defs/идентификатор" },
        "хэши_свидетельств": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/хэш" }
        }
      }
    },
    "ребро_интеграции": {
      "type": "object",
      "additionalProperties": false,
      "required": ["идентификатор_решения", "родительские_вершины", "результирующая_вершина"],
      "properties": {
        "идентификатор_решения": { "$ref": "#/$defs/идентификатор" },
        "родительские_вершины": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/git_объект" }
        },
        "результирующая_вершина": { "$ref": "#/$defs/git_объект" }
      }
    }
  }
}
