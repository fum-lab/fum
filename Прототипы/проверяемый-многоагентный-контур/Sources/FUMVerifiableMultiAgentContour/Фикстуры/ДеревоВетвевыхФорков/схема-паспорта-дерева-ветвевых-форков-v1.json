{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fum:schema:passport-fork-tree:v1",
  "title": "Паспорт дерева ветвевых форков v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "поколение_схемы",
    "идентификатор_паспорта",
    "хэш_паспорта",
    "идентификатор_дерева",
    "идентификатор_поколения",
    "порядок_поколения",
    "идентификатор_корня",
    "формат_git_объектов",
    "родитель",
    "дети",
    "исходное_состояние",
    "модерация",
    "границы",
    "сохранённые_узлы",
    "сохранённые_развилки"
  ],
  "properties": {
    "поколение_схемы": { "const": 1 },
    "идентификатор_паспорта": { "$ref": "#/$defs/идентификатор" },
    "хэш_паспорта": { "$ref": "#/$defs/хэш" },
    "идентификатор_дерева": { "$ref": "#/$defs/идентификатор" },
    "идентификатор_поколения": { "$ref": "#/$defs/идентификатор" },
    "порядок_поколения": { "type": "integer", "minimum": 1 },
    "идентификатор_корня": { "$ref": "#/$defs/идентификатор" },
    "формат_git_объектов": { "enum": ["sha1", "sha256"] },
    "родитель": { "$ref": "#/$defs/узел" },
    "дети": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ребёнок" }
    },
    "исходное_состояние": { "$ref": "#/$defs/исходное_состояние" },
    "модерация": { "$ref": "#/$defs/модерация" },
    "границы": { "$ref": "#/$defs/границы" },
    "сохранённые_узлы": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/узел" }
    },
    "сохранённые_развилки": {
      "type": "array",
      "maxItems": 2048,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/развилка" }
    }
  },
  "$defs": {
    "идентификатор": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!\\u007E)(?!\\.{1,2}$)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*[\\\\/])[^\\u0000-\\u001F\\u007F]{1,240}$"
    },
    "хэш": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_объект": {
      "type": "string",
      "oneOf": [
        { "pattern": "^[0-9a-f]{40}$" },
        { "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "рабочая_ссылка": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^refs/heads/(?!@$)(?!\\.)(?!.*[/]\\.)(?![^/]*\\.lock(?:/|$))(?!.*[/][^/]*\\.lock(?:/|$))(?!.*\\.\\.)(?!.*@\\{)(?!.*[\\u0000-\\u0020\\u007F\\u007E^:?*\\[\\\\])(?!.*\\.$)[^/]+(?:/[^/]+)*$"
    },
    "необязательный_идентификатор": {
      "oneOf": [
        { "$ref": "#/$defs/идентификатор" },
        { "type": "null" }
      ]
    },
    "бюджет": {
      "type": "object",
      "additionalProperties": false,
      "required": ["токены", "секунды", "изменённые_файлы"],
      "properties": {
        "токены": { "type": "integer", "minimum": 0 },
        "секунды": { "type": "integer", "minimum": 0 },
        "изменённые_файлы": { "type": "integer", "minimum": 0 }
      }
    },
    "список_идентификаторов": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/идентификатор" }
    },
    "узел": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "идентификатор_fork",
        "идентификатор_родителя",
        "идентификатор_репозитория",
        "рабочая_ссылка",
        "идентификатор_checkout",
        "исходная_вершина",
        "хэш_назначения",
        "остаток_глубины",
        "бюджет",
        "полномочия",
        "эффекты"
      ],
      "properties": {
        "идентификатор_fork": { "$ref": "#/$defs/идентификатор" },
        "идентификатор_родителя": { "$ref": "#/$defs/необязательный_идентификатор" },
        "идентификатор_репозитория": { "$ref": "#/$defs/идентификатор" },
        "рабочая_ссылка": { "$ref": "#/$defs/рабочая_ссылка" },
        "идентификатор_checkout": { "$ref": "#/$defs/идентификатор" },
        "исходная_вершина": { "$ref": "#/$defs/git_объект" },
        "хэш_назначения": { "$ref": "#/$defs/хэш" },
        "остаток_глубины": { "type": "integer", "minimum": 0, "maximum": 32 },
        "бюджет": { "$ref": "#/$defs/бюджет" },
        "полномочия": { "$ref": "#/$defs/список_идентификаторов" },
        "эффекты": { "$ref": "#/$defs/список_идентификаторов" }
      }
    },
    "ребёнок": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "сторона",
        "идентификатор_fork",
        "идентификатор_родителя",
        "идентификатор_репозитория",
        "рабочая_ссылка",
        "идентификатор_checkout",
        "исходная_вершина",
        "хэш_назначения",
        "остаток_глубины",
        "бюджет",
        "полномочия",
        "эффекты"
      ],
      "properties": {
        "сторона": { "enum": ["левая", "правая"] },
        "идентификатор_fork": { "$ref": "#/$defs/идентификатор" },
        "идентификатор_родителя": { "$ref": "#/$defs/идентификатор" },
        "идентификатор_репозитория": { "$ref": "#/$defs/идентификатор" },
        "рабочая_ссылка": { "$ref": "#/$defs/рабочая_ссылка" },
        "идентификатор_checkout": { "$ref": "#/$defs/идентификатор" },
        "исходная_вершина": { "$ref": "#/$defs/git_объект" },
        "хэш_назначения": { "$ref": "#/$defs/хэш" },
        "остаток_глубины": { "type": "integer", "minimum": 0, "maximum": 32 },
        "бюджет": { "$ref": "#/$defs/бюджет" },
        "полномочия": { "$ref": "#/$defs/список_идентификаторов" },
        "эффекты": { "$ref": "#/$defs/список_идентификаторов" }
      }
    },
    "вершина_исходного_состояния": {
      "type": "object",
      "additionalProperties": false,
      "required": ["идентификатор_fork", "идентификатор_репозитория", "oid"],
      "properties": {
        "идентификатор_fork": { "$ref": "#/$defs/идентификатор" },
        "идентификатор_репозитория": { "$ref": "#/$defs/идентификатор" },
        "oid": { "$ref": "#/$defs/git_объект" }
      }
    },
    "исходное_состояние": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "идентификатор_класса_эквивалентности",
        "хэш_доказательства",
        "вершины"
      ],
      "properties": {
        "идентификатор_класса_эквивалентности": { "$ref": "#/$defs/идентификатор" },
        "хэш_доказательства": { "$ref": "#/$defs/хэш" },
        "вершины": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/вершина_исходного_состояния" }
        }
      }
    },
    "критерий": {
      "type": "object",
      "additionalProperties": false,
      "required": ["идентификатор", "версия", "хэш"],
      "properties": {
        "идентификатор": { "$ref": "#/$defs/идентификатор" },
        "версия": { "type": "integer", "minimum": 1 },
        "хэш": { "$ref": "#/$defs/хэш" }
      }
    },
    "модерация": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "идентификатор_модератора",
        "идентификатор_попытки",
        "идентификатор_репозитория",
        "родительская_рабочая_ссылка",
        "ссылка_состояния",
        "целевая_ссылка_интеграции",
        "ожидаемая_база",
        "хэш_критериев",
        "критерии"
      ],
      "properties": {
        "идентификатор_модератора": { "$ref": "#/$defs/идентификатор" },
        "идентификатор_попытки": { "$ref": "#/$defs/идентификатор" },
        "идентификатор_репозитория": { "$ref": "#/$defs/идентификатор" },
        "родительская_рабочая_ссылка": { "$ref": "#/$defs/рабочая_ссылка" },
        "ссылка_состояния": { "$ref": "#/$defs/рабочая_ссылка" },
        "целевая_ссылка_интеграции": { "$ref": "#/$defs/рабочая_ссылка" },
        "ожидаемая_база": { "$ref": "#/$defs/git_объект" },
        "хэш_критериев": { "$ref": "#/$defs/хэш" },
        "критерии": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/критерий" }
        }
      }
    },
    "границы": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "коэффициент_ветвления",
        "максимум_владельцев",
        "максимум_активных_детей",
        "глубина_рекурсии",
        "ресурсный_бюджет",
        "разрешённые_полномочия",
        "разрешённые_эффекты"
      ],
      "properties": {
        "коэффициент_ветвления": { "const": 2 },
        "максимум_владельцев": { "const": 1 },
        "максимум_активных_детей": { "const": 2 },
        "глубина_рекурсии": { "type": "integer", "minimum": 0, "maximum": 32 },
        "ресурсный_бюджет": { "$ref": "#/$defs/бюджет" },
        "разрешённые_полномочия": { "$ref": "#/$defs/список_идентификаторов" },
        "разрешённые_эффекты": { "$ref": "#/$defs/список_идентификаторов" }
      }
    },
    "развилка": {
      "type": "object",
      "additionalProperties": false,
      "required": ["идентификатор_поколения", "идентификатор_родителя", "дети"],
      "properties": {
        "идентификатор_поколения": { "$ref": "#/$defs/идентификатор" },
        "идентификатор_родителя": { "$ref": "#/$defs/идентификатор" },
        "дети": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/идентификатор" }
        }
      }
    },
    "ребро_интеграции": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "идентификатор_решения",
        "родительские_вершины",
        "результирующая_вершина"
      ],
      "properties": {
        "идентификатор_решения": { "$ref": "#/$defs/идентификатор" },
        "родительские_вершины": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/git_объект" }
        },
        "результирующая_вершина": { "$ref": "#/$defs/git_объект" }
      }
    }
  }
}
