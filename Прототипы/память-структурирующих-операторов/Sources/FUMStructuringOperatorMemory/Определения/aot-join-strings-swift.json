                  ["равно", ["путь", ["переменная", "вход"], "схема"], "fuma.граф-JSON.1"],
                  [
                    "если",
                    ["равно", ["путь", ["переменная", "вход"], "числа"], "целые64-без-дробей"],
                    [
                      "если",
