{
  "схема": "fum.определение-оператора.1",
  "идентификатор": "fum.vkhod-jsonl-fuma",
  "версия": 1,
  "правила": [],
  "шаги": [
    {
      "идентификатор": "проекция",
      "оператор": "вычислить-JSON",
      "аргументы": {
        "граф": {
          "схема": "fuma.граф-JSON.1",
          "числа": "целые64-без-дробей",
          "переменные": [
            {
              "имя": "тип_записи",
              "значение": ["путь", ["переменная", "вход"], "type"]
            },
            {
              "имя": "это_response_item",
              "значение": ["равно", ["переменная", "тип_записи"], "response_item"]
            },
            {
              "имя": "тип_payload",
              "значение": [
                "если", ["переменная", "это_response_item"],
                ["путь", ["переменная", "вход"], "payload", "type"],
                "неподдержано"
              ]
            },
            {
              "имя": "это_message",
              "значение": ["равно", ["переменная", "тип_payload"], "message"]
            },
            {
              "имя": "это_output",
              "значение": ["равно", ["переменная", "тип_payload"], "function_call_output"]
            },
            {
              "имя": "классификация",
              "значение": [
                "если", ["переменная", "это_message"], "message",
                ["если", ["переменная", "это_output"], "function_call_output", "неподдержано"]
              ]
            },
            {
              "имя": "роль",
              "значение": [
                "если", ["переменная", "это_message"],
                ["путь", ["переменная", "вход"], "payload", "role"], ["null"]
              ]
            },
            {
              "имя": "части_message",
              "значение": [
                "если", ["переменная", "это_message"],
                [
                  "отобразить", ["путь", ["переменная", "вход"], "payload", "content"], "часть",
                  {
                    "type": ["путь", ["переменная", "часть"], "type"],
                    "text": [
                      "если",
                      ["равно", ["путь", ["переменная", "часть"], "type"], "input_text"],
                      ["путь", ["переменная", "часть"], "text"],
                      [
                        "если",
                        ["равно", ["путь", ["переменная", "часть"], "type"], "output_text"],
                        ["путь", ["переменная", "часть"], "text"],
                        [
                          "если",
                          ["равно", ["путь", ["переменная", "часть"], "type"], "text"],
                          ["путь", ["переменная", "часть"], "text"], ["null"]
                        ]
                      ]
                    ]
                  }
                ],
                ["массив"]
              ]
            },
            {
              "имя": "части_output",
              "значение": [
                "если", ["переменная", "это_output"],
                [
                  "массив",
                  {
                    "type": "function_call_output",
                    "text": ["путь", ["переменная", "вход"], "payload", "output"]
                  }
                ],
                ["массив"]
              ]
            },
            {
              "имя": "текстовые_части",
              "значение": [
                "если", ["переменная", "это_message"], ["переменная", "части_message"],
                ["переменная", "части_output"]
              ]
            }
          ],
          "результат": {
            "classification": ["переменная", "классификация"],
            "payload_type": ["переменная", "тип_payload"],
            "role": ["переменная", "роль"],
            "text_parts": ["переменная", "текстовые_части"]
          }
        }
      }
    }
  ]
}
