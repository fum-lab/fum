{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Декодированная строка ответа read_thread версии 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "thread",
    "page",
    "turns"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "codex"
        },
        "hostId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "preview": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "status": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "activeFlags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "createdAt": {
          "type": [
            "integer",
            "null"
          ]
        },
        "updatedAt": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "limit",
        "nextCursor",
        "hasMore"
      ],
      "properties": {
        "order": {
          "const": "newest_first"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "hasMore": {
          "type": "boolean"
        }
      }
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "error",
          "startedAt",
          "completedAt",
          "durationMs",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "error": {},
          "startedAt": {
            "type": [
              "integer",
              "null"
            ]
          },
          "completedAt": {
            "type": [
              "integer",
              "null"
            ]
          },
          "durationMs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "id",
                    "text",
                    "phase"
                  ],
                  "properties": {
                    "type": {
                      "const": "agentMessage"
                    },
                    "id": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "phase": {
                      "enum": [
                        "commentary",
                        "final"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "commandExecution",
                        "mcpToolCall",
                        "reasoning",
                        "userMessage"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
