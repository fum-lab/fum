{
  "$defs": {
    "адаптер": {
      "additionalProperties": false,
      "properties": {
        "контракт": {
          "minLength": 1,
          "type": "string"
        },
        "тип": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["тип", "контракт"],
      "type": "object"
    },
    "защита_поколения": {
      "additionalProperties": false,
      "properties": {
        "область": {
          "const": "рабочая_копия_ветка_задание"
        },
        "поколение": {
          "minimum": 1,
          "type": "integer"
        },
        "тип": {
          "const": "поколение_и_наступление"
        }
      },
      "required": ["тип", "область", "поколение"],
      "type": "object"
    },
    "задание": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "эффект": {
                "properties": {
                  "класс": {
                    "enum": ["изменение_репозитория", "внешний_эффект"]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "исполнитель": {
                "properties": {
                  "контракт": {
                    "const": "обычная-корневая-задача-Codex.1"
                  },
                  "тип": {
                    "const": "обычная_корневая_задача_Codex"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "job_id": {
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "type": "string"
        },
        "адаптер": {
          "$ref": "#/$defs/адаптер"
        },
        "защита_поколения": {
          "$ref": "#/$defs/защита_поколения"
        },
        "исполнитель": {
          "$ref": "#/$defs/исполнитель"
        },
        "курсор_результата": {
          "oneOf": [
            {
              "$ref": "#/$defs/курсор_расписания"
            },
            {
              "$ref": "#/$defs/курсор_событий"
            },
            {
              "$ref": "#/$defs/курсор_аналитики"
            }
          ]
        },
        "поколение": {
          "minimum": 1,
          "type": "integer"
        },
        "политика_ошибки": {
          "$ref": "#/$defs/политика_ошибки"
        },
        "приоритет": {
          "minimum": 0,
          "type": "integer"
        },
        "состояние": {
          "enum": ["active", "paused", "blocked", "retired"],
          "type": "string"
        },
        "триггер": {
          "oneOf": [
            {
              "$ref": "#/$defs/триггер_расписания"
            },
            {
              "$ref": "#/$defs/триггер_порога"
            }
          ]
        },
        "условия_допуска": {
          "items": {
            "$ref": "#/$defs/условие"
          },
          "type": "array"
        },
        "цель": {
          "$ref": "#/$defs/цель"
        },
        "эффект": {
          "$ref": "#/$defs/эффект"
        }
      },
      "required": [
        "job_id",
        "поколение",
        "приоритет",
        "адаптер",
        "цель",
        "триггер",
        "условия_допуска",
        "состояние",
        "эффект",
        "исполнитель",
        "защита_поколения",
        "курсор_результата",
        "политика_ошибки"
      ],
      "type": "object"
    },
    "исполнитель": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "контракт": {
              "const": "локальный-симулятор.1"
            },
            "тип": {
              "const": "локальный_пробник"
            }
          },
          "required": ["тип", "контракт"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "контракт": {
              "const": "обычная-корневая-задача-Codex.1"
            },
            "тип": {
              "const": "обычная_корневая_задача_Codex"
            }
          },
          "required": ["тип", "контракт"],
          "type": "object"
        }
      ]
    },
    "курсор_расписания": {
      "additionalProperties": false,
      "properties": {
        "последнее_наступление": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            }
          ]
        },
        "тип": {
          "const": "расписание"
        }
      },
      "required": ["тип", "последнее_наступление"],
      "type": "object"
    },
    "курсор_событий": {
      "additionalProperties": false,
      "properties": {
        "последнее_число_подтверждённых_событий": {
          "minimum": 0,
          "type": "integer"
        },
        "последний_идентификатор_события": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ]
        },
        "следующий_порог": {
          "minimum": 1,
          "type": "integer"
        },
        "тип": {
          "const": "подтверждённые_события"
        }
      },
      "required": [
        "тип",
        "последнее_число_подтверждённых_событий",
        "последний_идентификатор_события",
        "следующий_порог"
      ],
      "type": "object"
    },
    "курсор_аналитики": {
      "additionalProperties": false,
      "properties": {
        "начальная_граница": {
          "additionalProperties": false,
          "properties": {
            "минимальная_версия_claim": {
              "minimum": 5,
              "type": "integer"
            },
            "тип": {
              "const": "версия_карточной_претензии"
            },
            "число_событий": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": ["тип", "минимальная_версия_claim", "число_событий"],
          "type": "object"
        },
        "область_анализа": {
          "additionalProperties": false,
          "properties": {
            "branch_ref": {
              "pattern": "^refs/heads/(?![-.])(?!.*[/][-.])(?!.*[.][.])(?!.*[.]lock(?:[/]|$))(?!.*[.](?:[/]|$))(?!.*[/][/])(?!.*[/]$)[A-Za-z0-9_][A-Za-z0-9._/-]*(?![\\d\\D])",
              "type": "string"
            },
            "job_id": {
              "const": "master.next-step"
            },
            "источник": {
              "const": "runtime_ready"
            },
            "результат": {
              "const": "commit+handoff"
            }
          },
          "required": ["branch_ref", "job_id", "источник", "результат"],
          "type": "object"
        },
        "последнее_число_подтверждённых_событий": {
          "minimum": 0,
          "type": "integer"
        },
        "последний_идентификатор_события": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ]
        },
        "последний_подтверждённый_аналитический_результат": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "additionalProperties": false,
              "properties": {
                "content_sha256": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                "идентификатор": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                "конец_диапазона": {
                  "minimum": 1,
                  "type": "integer"
                },
                "путь": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": ["идентификатор", "путь", "content_sha256", "конец_диапазона"],
              "type": "object"
            }
          ]
        },
        "следующий_порог": {
          "minimum": 1,
          "type": "integer"
        },
        "тип": {
          "const": "подтверждённые_события"
        }
      },
      "required": [
        "тип",
        "последнее_число_подтверждённых_событий",
        "последний_идентификатор_события",
        "следующий_порог",
        "начальная_граница",
        "область_анализа",
        "последний_подтверждённый_аналитический_результат"
      ],
      "type": "object"
    },
    "политика_ошибки": {
      "additionalProperties": false,
      "properties": {
        "неоднозначный_результат": {
          "enum": ["заблокировать", "потребовать_ручную_проверку"]
        },
        "повтор": {
          "enum": ["следующий_тик", "вручную", "никогда"]
        },
        "режим": {
          "const": "закрытый_отказ"
        }
      },
      "required": ["режим", "повтор", "неоднозначный_результат"],
      "type": "object"
    },
    "триггер_порога": {
      "additionalProperties": false,
      "properties": {
        "каждые": {
          "minimum": 1,
          "type": "integer"
        },
        "тип": {
          "const": "порог_подтверждённых_событий"
        },
        "тип_события": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["тип", "тип_события", "каждые"],
      "type": "object"
    },
    "триггер_расписания": {
      "additionalProperties": false,
      "properties": {
        "интервал_секунды": {
          "minimum": 1,
          "type": "integer"
        },
        "тип": {
          "const": "расписание"
        },
        "якорь": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        }
      },
      "required": ["тип", "якорь", "интервал_секунды"],
      "type": "object"
    },
    "условие": {
      "additionalProperties": false,
      "properties": {
        "идентификатор": {
          "minLength": 1,
          "type": "string"
        },
        "наблюдение": {
          "minLength": 1,
          "type": "string"
        },
        "ожидается": {
          "type": "boolean"
        }
      },
      "required": ["идентификатор", "наблюдение", "ожидается"],
      "type": "object"
    },
    "цель": {
      "additionalProperties": false,
      "properties": {
        "branch_ref": {
          "pattern": "^refs/heads/(?![-.])(?!.*[/][-.])(?!.*[.][.])(?!.*[.]lock(?:[/]|$))(?!.*[.](?:[/]|$))(?!.*[/][/])(?!.*[/]$)[A-Za-z0-9_][A-Za-z0-9._/-]*(?![\\d\\D])",
          "type": "string"
        },
        "идентификатор_проекта": {
          "minLength": 1,
          "type": "string"
        },
        "путь_проекта": {
          "minLength": 1,
          "type": "string"
        },
        "якорь_рабочей_копии": {
          "const": "."
        }
      },
      "required": [
        "branch_ref",
        "якорь_рабочей_копии",
        "идентификатор_проекта",
        "путь_проекта"
      ],
      "type": "object"
    },
    "эффект": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "класс": {
              "const": "только_чтение"
            },
            "политика": {
              "const": "без_побочных_эффектов"
            }
          }
        },
        {
          "properties": {
            "класс": {
              "const": "изменение_репозитория"
            },
            "политика": {
              "const": "только_через_очередь_и_локальную_передачу_коммита"
            }
          }
        },
        {
          "properties": {
            "класс": {
              "const": "внешний_эффект"
            },
            "политика": {
              "const": "требуется_явное_разрешение"
            }
          }
        }
      ],
      "properties": {
        "класс": {
          "enum": [
            "только_чтение",
            "изменение_репозитория",
            "внешний_эффект"
          ],
          "type": "string"
        },
        "политика": {
          "enum": [
            "без_побочных_эффектов",
            "только_через_очередь_и_локальную_передачу_коммита",
            "требуется_явное_разрешение"
          ],
          "type": "string"
        }
      },
      "required": ["класс", "политика"],
      "type": "object"
    }
  },
  "$id": "fum.automation-job-registry.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "branch_ref": {
      "pattern": "^refs/heads/(?![-.])(?!.*[/][-.])(?!.*[.][.])(?!.*[.]lock(?:[/]|$))(?!.*[.](?:[/]|$))(?!.*[/][/])(?!.*[/]$)[A-Za-z0-9_][A-Za-z0-9._/-]*(?![\\d\\D])",
      "type": "string"
    },
    "версия_схемы": {
      "const": 1
    },
    "задания": {
      "items": {
        "$ref": "#/$defs/задание"
      },
      "type": "array"
    },
    "идентификатор_проекта": {
      "minLength": 1,
      "type": "string"
    },
    "идентификатор_реестра": {
      "minLength": 1,
      "type": "string"
    },
    "поколение_реестра": {
      "minimum": 1,
      "type": "integer"
    },
    "путь_проекта": {
      "minLength": 1,
      "type": "string"
    },
    "якорь_рабочей_копии": {
      "const": "."
    }
  },
  "required": [
    "версия_схемы",
    "идентификатор_реестра",
    "поколение_реестра",
    "branch_ref",
    "якорь_рабочей_копии",
    "идентификатор_проекта",
    "путь_проекта",
    "задания"
  ],
  "title": "Реестр заданий диспетчера автоматизаций FUM, версия 1",
  "type": "object"
}
