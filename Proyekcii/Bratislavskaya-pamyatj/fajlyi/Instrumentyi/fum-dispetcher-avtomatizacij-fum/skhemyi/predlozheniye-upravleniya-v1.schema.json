{
  "$defs": {
    "данные_host_active": {
      "additionalProperties": false,
      "properties": {
        "текущий_статус": {
          "const": "ACTIVE"
        }
      },
      "required": ["текущий_статус"],
      "type": "object"
    },
    "данные_host_paused": {
      "additionalProperties": false,
      "properties": {
        "текущий_статус": {
          "const": "PAUSED"
        }
      },
      "required": ["текущий_статус"],
      "type": "object"
    },
    "данные_добавления": {
      "additionalProperties": false,
      "properties": {
        "задание": {
          "$ref": "реестр-заданий-v1.schema.json#/$defs/задание"
        }
      },
      "required": ["задание"],
      "type": "object"
    },
    "данные_задания": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "$ref": "#/$defs/job_id"
        }
      },
      "required": ["job_id"],
      "type": "object"
    },
    "данные_снятия_блокировки": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "новое_состояние": {
          "enum": ["active", "paused"],
          "type": "string"
        }
      },
      "required": ["job_id", "новое_состояние"],
      "type": "object"
    },
    "данные_триггера": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "курсор_результата": {
          "oneOf": [
            {
              "$ref": "реестр-заданий-v1.schema.json#/$defs/курсор_расписания"
            },
            {
              "$ref": "реестр-заданий-v1.schema.json#/$defs/курсор_событий"
            }
          ]
        },
        "триггер": {
          "oneOf": [
            {
              "$ref": "реестр-заданий-v1.schema.json#/$defs/триггер_расписания"
            },
            {
              "$ref": "реестр-заданий-v1.schema.json#/$defs/триггер_порога"
            }
          ]
        }
      },
      "required": ["job_id", "триггер", "курсор_результата"],
      "type": "object"
    },
    "данные_условий": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "условия_допуска": {
          "items": {
            "$ref": "реестр-заданий-v1.schema.json#/$defs/условие"
          },
          "type": "array"
        }
      },
      "required": ["job_id", "условия_допуска"],
      "type": "object"
    },
    "изменение": {
      "additionalProperties": false,
      "properties": {
        "новое": {},
        "путь": {
          "minLength": 1,
          "pattern": "^/[^\\r\\n\\u0000]+$",
          "type": "string"
        },
        "старое": {}
      },
      "required": ["путь", "старое", "новое"],
      "type": "object"
    },
    "job_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "поколение_или_null": {
      "oneOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "хэш_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "fum.dispatcher-control-proposal.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "намерение": {
            "const": "приостановить_heartbeat"
          }
        },
        "required": ["намерение"]
      },
      "then": {
        "properties": {
          "данные": {
            "$ref": "#/$defs/данные_host_active"
          },
          "job_id": {
            "type": "null"
          },
          "класс_эффекта": {
            "const": "изменение_host_runtime"
          },
          "новое_поколение_задания": {
            "type": "null"
          },
          "область": {
            "const": "host_runtime"
          },
          "ожидаемое_поколение_задания": {
            "type": "null"
          },
          "эффект_задания": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "намерение": {
            "const": "возобновить_heartbeat"
          }
        },
        "required": ["намерение"]
      },
      "then": {
        "properties": {
          "данные": {
            "$ref": "#/$defs/данные_host_paused"
          },
          "job_id": {
            "type": "null"
          },
          "класс_эффекта": {
            "const": "изменение_host_runtime"
          },
          "новое_поколение_задания": {
            "type": "null"
          },
          "область": {
            "const": "host_runtime"
          },
          "ожидаемое_поколение_задания": {
            "type": "null"
          },
          "эффект_задания": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "намерение": {
            "enum": [
              "приостановить_задание",
              "возобновить_задание",
              "заблокировать_задание",
              "снять_блокировку",
              "изменить_триггер",
              "заменить_условия",
              "добавить_задание",
              "вывести_из_эксплуатации"
            ]
          }
        },
        "required": ["намерение"]
      },
      "then": {
        "properties": {
          "job_id": {
            "$ref": "#/$defs/job_id"
          },
          "класс_эффекта": {
            "const": "изменение_репозитория"
          },
          "область": {
            "const": "реестр"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "намерение": {
            "const": "добавить_задание"
          }
        },
        "required": ["намерение"]
      },
      "then": {
        "properties": {
          "новое_поколение_задания": {
            "minimum": 1,
            "type": "integer"
          },
          "ожидаемое_поколение_задания": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "намерение": {
            "enum": [
              "приостановить_задание",
              "возобновить_задание",
              "заблокировать_задание",
              "снять_блокировку",
              "изменить_триггер",
              "заменить_условия",
              "вывести_из_эксплуатации"
            ]
          }
        },
        "required": ["намерение"]
      },
      "then": {
        "properties": {
          "новое_поколение_задания": {
            "minimum": 1,
            "type": "integer"
          },
          "ожидаемое_поколение_задания": {
            "minimum": 1,
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "намерение": {
            "enum": [
              "приостановить_задание",
              "возобновить_задание",
              "заблокировать_задание",
              "вывести_из_эксплуатации"
            ]
          }
        },
        "required": ["намерение"]
      },
      "then": {
        "properties": {
          "данные": {
            "$ref": "#/$defs/данные_задания"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "намерение": {
            "const": "снять_блокировку"
          }
        },
        "required": ["намерение"]
      },
      "then": {
        "properties": {
          "данные": {
            "$ref": "#/$defs/данные_снятия_блокировки"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "намерение": {
            "const": "изменить_триггер"
          }
        },
        "required": ["намерение"]
      },
      "then": {
        "properties": {
          "данные": {
            "$ref": "#/$defs/данные_триггера"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "намерение": {
            "const": "заменить_условия"
          }
        },
        "required": ["намерение"]
      },
      "then": {
        "properties": {
          "данные": {
            "$ref": "#/$defs/данные_условий"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "намерение": {
            "const": "добавить_задание"
          }
        },
        "required": ["намерение"]
      },
      "then": {
        "properties": {
          "данные": {
            "$ref": "#/$defs/данные_добавления"
          }
        }
      }
    }
  ],
  "properties": {
    "job_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/job_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "данные": {
      "oneOf": [
        {
          "$ref": "#/$defs/данные_host_active"
        },
        {
          "$ref": "#/$defs/данные_host_paused"
        },
        {
          "$ref": "#/$defs/данные_задания"
        },
        {
          "$ref": "#/$defs/данные_снятия_блокировки"
        },
        {
          "$ref": "#/$defs/данные_триггера"
        },
        {
          "$ref": "#/$defs/данные_условий"
        },
        {
          "$ref": "#/$defs/данные_добавления"
        }
      ]
    },
    "идентификатор_предложения": {
      "$ref": "#/$defs/хэш_sha256"
    },
    "идентификатор_сообщения": {
      "minLength": 1,
      "pattern": "^[^\\r\\n\\u0000]+$",
      "type": "string"
    },
    "изменения": {
      "items": {
        "$ref": "#/$defs/изменение"
      },
      "minItems": 1,
      "type": "array"
    },
    "класс_эффекта": {
      "enum": ["изменение_репозитория", "изменение_host_runtime"],
      "type": "string"
    },
    "намерение": {
      "enum": [
        "приостановить_задание",
        "возобновить_задание",
        "заблокировать_задание",
        "снять_блокировку",
        "изменить_триггер",
        "заменить_условия",
        "добавить_задание",
        "вывести_из_эксплуатации",
        "приостановить_heartbeat",
        "возобновить_heartbeat"
      ],
      "type": "string"
    },
    "новое_поколение_задания": {
      "$ref": "#/$defs/поколение_или_null"
    },
    "новое_поколение_реестра": {
      "minimum": 1,
      "type": "integer"
    },
    "новый_хэш_реестра": {
      "$ref": "#/$defs/хэш_sha256"
    },
    "область": {
      "enum": ["реестр", "host_runtime"],
      "type": "string"
    },
    "ожидаемая_вершина": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "ожидаемое_поколение_задания": {
      "$ref": "#/$defs/поколение_или_null"
    },
    "ожидаемое_поколение_реестра": {
      "minimum": 1,
      "type": "integer"
    },
    "ожидаемый_хэш_реестра": {
      "$ref": "#/$defs/хэш_sha256"
    },
    "последствия": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "реестр_после": {
      "$ref": "реестр-заданий-v1.schema.json"
    },
    "схема": {
      "const": "fum.dispatcher-control-proposal.v1"
    },
    "требуемые_подтверждения": {
      "items": {
        "enum": [
          "применить",
          "снять_safety_блокировку",
          "разрешить_внешний_эффект",
          "изменить_подтверждённый_курсор",
          "изменить_remote_или_ref"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "хэш_сообщения": {
      "$ref": "#/$defs/хэш_sha256"
    },
    "эффект_задания": {
      "oneOf": [
        {
          "$ref": "реестр-заданий-v1.schema.json#/$defs/эффект"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "схема",
    "идентификатор_предложения",
    "идентификатор_сообщения",
    "хэш_сообщения",
    "намерение",
    "область",
    "ожидаемая_вершина",
    "ожидаемый_хэш_реестра",
    "ожидаемое_поколение_реестра",
    "новый_хэш_реестра",
    "новое_поколение_реестра",
    "job_id",
    "ожидаемое_поколение_задания",
    "новое_поколение_задания",
    "изменения",
    "класс_эффекта",
    "эффект_задания",
    "последствия",
    "требуемые_подтверждения",
    "данные",
    "реестр_после"
  ],
  "type": "object"
}
