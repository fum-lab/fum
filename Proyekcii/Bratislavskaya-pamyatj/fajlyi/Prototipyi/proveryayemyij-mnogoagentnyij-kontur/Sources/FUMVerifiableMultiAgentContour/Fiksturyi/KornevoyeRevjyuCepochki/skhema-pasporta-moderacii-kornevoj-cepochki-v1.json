{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fum:%D0%BF%D0%B0%D1%81%D0%BF%D0%BE%D1%80%D1%82-%D0%BC%D0%BE%D0%B4%D0%B5%D1%80%D0%B0%D1%86%D0%B8%D0%B8-%D0%BA%D0%BE%D1%80%D0%BD%D0%B5%D0%B2%D0%BE%D0%B9-%D1%86%D0%B5%D0%BF%D0%BE%D1%87%D0%BA%D0%B8:v1",
  "title": "Паспорт модерации корневой цепочки v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "идентификаторРодителяМодератора",
    "идентификаторПопытки",
    "поколениеНазначения",
    "идентификаторРодительскогоРепозитория",
    "каноническийПутьРодительскогоРепозитория",
    "провереннаяБаза",
    "родительскаяРабочаяСсылка",
    "ссылкаСостояния",
    "целеваяСсылкаИнтеграции",
    "идентификаторЛевогоРебёнка",
    "идентификаторЛевогоРепозитория",
    "леваяБаза",
    "леваяРабочаяСсылка",
    "леваяВершина",
    "леваяСсылкаРезультата",
    "хэшКритериев",
    "решение",
    "родителиИнтеграционнойВершины",
    "левыйРезультат"
  ],
  "properties": {
    "идентификаторРодителяМодератора": { "$ref": "#/$defs/идентификатор" },
    "идентификаторПопытки": { "$ref": "#/$defs/идентификатор" },
    "поколениеНазначения": { "$ref": "#/$defs/идентификатор" },
    "идентификаторРодительскогоРепозитория": { "$ref": "#/$defs/идентификатор" },
    "каноническийПутьРодительскогоРепозитория": { "$ref": "#/$defs/каноническийПуть" },
    "провереннаяБаза": { "$ref": "#/$defs/объектГит" },
    "родительскаяРабочаяСсылка": { "$ref": "#/$defs/полнаяСсылка" },
    "ссылкаСостояния": { "$ref": "#/$defs/полнаяСсылка" },
    "целеваяСсылкаИнтеграции": { "$ref": "#/$defs/полнаяСсылка" },
    "идентификаторЛевогоРебёнка": { "$ref": "#/$defs/идентификатор" },
    "идентификаторЛевогоРепозитория": { "$ref": "#/$defs/идентификатор" },
    "леваяБаза": { "$ref": "#/$defs/объектГит" },
    "леваяРабочаяСсылка": { "$ref": "#/$defs/полнаяСсылка" },
    "леваяВершина": { "$ref": "#/$defs/объектГит" },
    "леваяСсылкаРезультата": { "$ref": "#/$defs/полнаяСсылка" },
    "идентификаторПравогоРебёнка": { "$ref": "#/$defs/идентификатор" },
    "идентификаторПравогоРепозитория": { "$ref": "#/$defs/идентификатор" },
    "праваяБаза": { "$ref": "#/$defs/объектГит" },
    "праваяРабочаяСсылка": { "$ref": "#/$defs/полнаяСсылка" },
    "праваяВершина": { "$ref": "#/$defs/объектГит" },
    "праваяСсылкаРезультата": { "$ref": "#/$defs/полнаяСсылка" },
    "хэшКритериев": { "$ref": "#/$defs/хэш" },
    "решение": {
      "enum": [
        "выбран_левый_результат",
        "выбран_правый_результат",
        "совместимое_объединение",
        "доработка_в_новом_поколении_назначения",
        "отклонены_оба",
        "неопределённость"
      ]
    },
    "интеграционнаяВершина": { "$ref": "#/$defs/объектГит" },
    "родителиИнтеграционнойВершины": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/объектГит" }
    },
    "левыйРезультат": { "$ref": "#/$defs/замороженныйРезультат" },
    "правыйРезультат": { "$ref": "#/$defs/замороженныйРезультат" }
  },
  "oneOf": [
    {
      "required": [
        "идентификаторПравогоРебёнка",
        "идентификаторПравогоРепозитория",
        "праваяБаза",
        "праваяРабочаяСсылка",
        "праваяВершина",
        "праваяСсылкаРезультата",
        "правыйРезультат"
      ]
    },
    {
      "not": {
        "anyOf": [
          { "required": ["идентификаторПравогоРебёнка"] },
          { "required": ["идентификаторПравогоРепозитория"] },
          { "required": ["праваяБаза"] },
          { "required": ["праваяРабочаяСсылка"] },
          { "required": ["праваяВершина"] },
          { "required": ["праваяСсылкаРезультата"] },
          { "required": ["правыйРезультат"] }
        ]
      }
    }
  ],
  "$defs": {
    "идентификатор": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!\\u007E)(?!\\.{1,2}$)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*[\\\\/])[^\\u0000-\\u001F\\u007F\\s]{1,240}$"
    },
    "хэш": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "объектГит": {
      "type": "string",
      "oneOf": [
        { "pattern": "^[0-9a-f]{40}$" },
        { "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "полнаяСсылка": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^refs/(?!@$)(?!\\.)(?!.*[/]\\.)(?![^/]*\\.lock(?:/|$))(?!.*[/][^/]*\\.lock(?:/|$))(?!.*\\.\\.)(?!.*@\\{)(?!.*[\\u0000-\\u0020\\u007F\\u007E^:?*\\[\\\\])(?!.*\\.$)[^/]+(?:/[^/]+)+$"
    },
    "каноническийПуть": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001F\\u007F])[^/]+(?:/[^/]+)*$"
    },
    "коммит": {
      "type": "object",
      "additionalProperties": false,
      "required": ["объект", "родители"],
      "properties": {
        "объект": { "$ref": "#/$defs/объектГит" },
        "родители": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/объектГит" }
        }
      }
    },
    "замороженныйРезультат": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "идентификаторФорка",
        "идентификаторРепозитория",
        "каноническийПутьРепозитория",
        "исходнаяВершина",
        "рабочаяСсылка",
        "ссылкаРезультата",
        "вершинаРезультата",
        "коммиты"
      ],
      "properties": {
        "идентификаторФорка": { "$ref": "#/$defs/идентификатор" },
        "идентификаторРепозитория": { "$ref": "#/$defs/идентификатор" },
        "каноническийПутьРепозитория": { "$ref": "#/$defs/каноническийПуть" },
        "исходнаяВершина": { "$ref": "#/$defs/объектГит" },
        "рабочаяСсылка": { "$ref": "#/$defs/полнаяСсылка" },
        "ссылкаРезультата": { "$ref": "#/$defs/полнаяСсылка" },
        "вершинаРезультата": { "$ref": "#/$defs/объектГит" },
        "коммиты": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": { "$ref": "#/$defs/коммит" }
        }
      }
    }
  }
}
