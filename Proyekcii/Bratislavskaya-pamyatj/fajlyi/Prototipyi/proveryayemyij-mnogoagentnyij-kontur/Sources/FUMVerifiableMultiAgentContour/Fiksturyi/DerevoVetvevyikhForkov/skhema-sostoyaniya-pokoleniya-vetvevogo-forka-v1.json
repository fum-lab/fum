{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fum:schema:fork-generation-state:v1",
  "title": "Состояние поколения ветвевого форка v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "поколение_схемы",
    "идентификатор_состояния",
    "хэш_состояния",
    "хэш_паспорта",
    "фаза",
    "родительская_граница",
    "host_попытка",
    "host_привязки",
    "активация_пары",
    "допуски_владельцев",
    "ожидающие_продолжения",
    "неактивные_дети",
    "внешние_проверяющие",
    "дочерние_переходы",
    "замороженные_результаты",
    "модерация",
    "интеграция"
  ],
  "properties": {
    "поколение_схемы": { "const": 1 },
    "идентификатор_состояния": { "$ref": "#/$defs/идентификатор" },
    "хэш_состояния": { "$ref": "#/$defs/хэш" },
    "хэш_паспорта": { "$ref": "#/$defs/хэш" },
    "фаза": { "enum": ["разрешён", "неопределён"] },
    "родительская_граница": { "$ref": "#/$defs/родительская_граница" },
    "host_попытка": { "$ref": "#/$defs/host_попытка" },
    "host_привязки": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/host_привязка" }
    },
    "активация_пары": { "$ref": "#/$defs/активация_пары" },
    "допуски_владельцев": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/допуск_владельца" }
    },
    "ожидающие_продолжения": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ожидающее_продолжение" }
    },
    "неактивные_дети": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/неактивный_ребёнок" }
    },
    "внешние_проверяющие": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/внешний_проверяющий" }
    },
    "дочерние_переходы": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/дочерний_переход" }
    },
    "замороженные_результаты": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/замороженный_результат" }
    },
    "модерация": { "$ref": "#/$defs/состояние_модерации" },
    "интеграция": { "$ref": "#/$defs/состояние_интеграции" }
  },
  "$defs": {
    "идентификатор": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!\\u007E)(?!\\.{1,2}$)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*[\\\\/])[^\\u0000-\\u001F\\u007F]{1,240}$"
    },
    "хэш": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_объект": {
      "type": "string",
      "oneOf": [
        { "pattern": "^[0-9a-f]{40}$" },
        { "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "рабочая_ссылка": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^refs/heads/(?!@$)(?!\\.)(?!.*[/]\\.)(?![^/]*\\.lock(?:/|$))(?!.*[/][^/]*\\.lock(?:/|$))(?!.*\\.\\.)(?!.*@\\{)(?!.*[\\u0000-\\u0020\\u007F\\u007E^:?*\\[\\\\])(?!.*\\.$)[^/]+(?:/[^/]+)*$"
    },
    "необязательный_идентификатор": {
      "oneOf": [
        { "$ref": "#/$defs/идентификатор" },
        { "type": "null" }
      ]
    },
    "необязательный_хэш": {
      "oneOf": [
        { "$ref": "#/$defs/хэш" },
        { "type": "null" }
      ]
    },
    "необязательный_git_объект": {
      "oneOf": [
        { "$ref": "#/$defs/git_объект" },
        { "type": "null" }
      ]
    },
    "бюджет": {
      "type": "object",
      "additionalProperties": false,
      "required": ["токены", "секунды", "изменённые_файлы"],
      "properties": {
        "токены": { "type": "integer", "minimum": 0 },
        "секунды": { "type": "integer", "minimum": 0 },
        "изменённые_файлы": { "type": "integer", "minimum": 0 }
      }
    },
    "родительская_граница": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "база",
        "вершина",
        "требовался_содержательный_коммит",
        "число_продолжений",
        "родительское_продолжение",
        "родительская_ссылка_неизменна",
        "сага_сохранена",
        "finish_clean_выполнен",
        "прежняя_host_сессия_освобождена",
        "родительский_FIFO_освобождён"
      ],
      "properties": {
        "база": { "$ref": "#/$defs/git_объект" },
        "вершина": { "$ref": "#/$defs/git_объект" },
        "требовался_содержательный_коммит": { "type": "boolean" },
        "число_продолжений": { "type": "integer", "minimum": 0, "maximum": 1 },
        "родительское_продолжение": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "идентификатор_владельца",
                "старая_вершина",
                "новая_вершина",
                "идентификатор_продолжения",
                "идентификатор_билета",
                "хэш_квитанции"
              ],
              "properties": {
                "идентификатор_владельца": { "$ref": "#/$defs/идентификатор" },
                "старая_вершина": { "$ref": "#/$defs/git_объект" },
                "новая_вершина": { "$ref": "#/$defs/git_объект" },
                "идентификатор_продолжения": { "$ref": "#/$defs/идентификатор" },
                "идентификатор_билета": { "$ref": "#/$defs/идентификатор" },
                "хэш_квитанции": { "$ref": "#/$defs/хэш" }
              }
            }
          ]
        },
        "родительская_ссылка_неизменна": { "type": "boolean" },
        "сага_сохранена": { "type": "boolean" },
        "finish_clean_выполнен": { "type": "boolean" },
        "прежняя_host_сессия_освобождена": { "type": "boolean" },
        "родительский_FIFO_освобождён": { "type": "boolean" }
      }
    },
    "host_попытка": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "идентификатор_попытки",
        "хэш_команды",
        "исход",
        "число_повторов",
        "хэш_авторитетного_чтения",
        "хэш_человеческого_восстановления"
      ],
      "properties": {
        "идентификатор_попытки": { "$ref": "#/$defs/идентификатор" },
        "хэш_команды": { "$ref": "#/$defs/хэш" },
        "исход": { "enum": ["подтверждён", "частичный", "неизвестный"] },
        "число_повторов": { "type": "integer", "minimum": 0 },
        "хэш_авторитетного_чтения": { "$ref": "#/$defs/необязательный_хэш" },
        "хэш_человеческого_восстановления": { "$ref": "#/$defs/необязательный_хэш" }
      }
    },
    "host_привязка": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "сторона",
        "идентификатор_fork",
        "идентификатор_thread",
        "идентификатор_host",
        "хэш_назначения",
        "неактивна",
        "запись_разрешена"
      ],
      "properties": {
        "сторона": { "enum": ["левая", "правая"] },
        "идентификатор_fork": { "$ref": "#/$defs/идентификатор" },
        "идентификатор_thread": { "$ref": "#/$defs/необязательный_идентификатор" },
        "идентификатор_host": { "$ref": "#/$defs/необязательный_идентификатор" },
        "хэш_назначения": { "$ref": "#/$defs/хэш" },
        "неактивна": { "const": true },
        "запись_разрешена": { "const": false }
      }
    },
    "активация_пары": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "состояние",
        "ожидаемый_хэш_состояния",
        "атомарная",
        "оба_ребёнка",
        "предактивация_сохранена"
      ],
      "properties": {
        "состояние": { "enum": ["не_активирована", "активирована"] },
        "ожидаемый_хэш_состояния": { "$ref": "#/$defs/хэш" },
        "атомарная": { "type": "boolean" },
        "оба_ребёнка": { "type": "boolean" },
        "предактивация_сохранена": { "type": "boolean" }
      }
    },
    "допуск_владельца": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "идентификатор_сессии",
        "идентификатор_fork",
        "вид",
        "идентификатор_репозитория",
        "целевая_ссылка",
        "допущен"
      ],
      "properties": {
        "идентификатор_сессии": { "$ref": "#/$defs/идентификатор" },
        "идентификатор_fork": { "$ref": "#/$defs/идентификатор" },
        "вид": { "enum": ["пишущий", "координатор_развилки", "модерирующий"] },
        "идентификатор_репозитория": { "$ref": "#/$defs/идентификатор" },
        "целевая_ссылка": { "$ref": "#/$defs/рабочая_ссылка" },
        "допущен": { "type": "boolean" }
      }
    },
    "ожидающее_продолжение": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "идентификатор_задачи",
        "идентификатор_билета",
        "идентификатор_fork",
        "идентификатор_репозитория",
        "рабочая_ссылка",
        "идентификатор_checkout",
        "подтверждённая_вершина",
        "ожидает"
      ],
      "properties": {
        "идентификатор_задачи": { "$ref": "#/$defs/идентификатор" },
        "идентификатор_билета": { "$ref": "#/$defs/идентификатор" },
        "идентификатор_fork": { "$ref": "#/$defs/идентификатор" },
        "идентификатор_репозитория": { "$ref": "#/$defs/идентификатор" },
        "рабочая_ссылка": { "$ref": "#/$defs/рабочая_ссылка" },
        "идентификатор_checkout": { "$ref": "#/$defs/идентификатор" },
        "подтверждённая_вершина": { "$ref": "#/$defs/git_объект" },
        "ожидает": { "const": true }
      }
    },
    "неактивный_ребёнок": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "идентификатор_задачи",
        "сторона",
        "идентификатор_fork",
        "неактивен",
        "запись_разрешена"
      ],
      "properties": {
        "идентификатор_задачи": { "$ref": "#/$defs/идентификатор" },
        "сторона": { "enum": ["левая", "правая"] },
        "идентификатор_fork": { "$ref": "#/$defs/идентификатор" },
        "неактивен": { "const": true },
        "запись_разрешена": { "const": false }
      }
    },
    "внешний_проверяющий": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "идентификатор_задачи",
        "идентификатор_fork",
        "хэш_результата",
        "запись_разрешена"
      ],
      "properties": {
        "идентификатор_задачи": { "$ref": "#/$defs/идентификатор" },
        "идентификатор_fork": { "$ref": "#/$defs/идентификатор" },
        "хэш_результата": { "$ref": "#/$defs/хэш" },
        "запись_разрешена": { "const": false }
      }
    },
    "дочерний_переход": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "порядок",
        "сторона",
        "идентификатор_fork",
        "идентификатор_репозитория",
        "рабочая_ссылка",
        "идентификатор_checkout",
        "идентификатор_владельца",
        "старая_вершина",
        "новая_вершина",
        "число_родителей",
        "число_продолжений",
        "идентификатор_продолжения",
        "хэш_квитанции"
      ],
      "properties": {
        "порядок": { "type": "integer", "minimum": 1 },
        "сторона": { "enum": ["левая", "правая"] },
        "идентификатор_fork": { "$ref": "#/$defs/идентификатор" },
        "идентификатор_репозитория": { "$ref": "#/$defs/идентификатор" },
        "рабочая_ссылка": { "$ref": "#/$defs/рабочая_ссылка" },
        "идентификатор_checkout": { "$ref": "#/$defs/идентификатор" },
        "идентификатор_владельца": { "$ref": "#/$defs/идентификатор" },
        "старая_вершина": { "$ref": "#/$defs/git_объект" },
        "новая_вершина": { "$ref": "#/$defs/git_объект" },
        "число_родителей": { "type": "integer", "minimum": 0, "maximum": 8 },
        "число_продолжений": { "type": "integer", "minimum": 0, "maximum": 8 },
        "идентификатор_продолжения": { "$ref": "#/$defs/необязательный_идентификатор" },
        "хэш_квитанции": { "$ref": "#/$defs/хэш" }
      }
    },
    "свидетельство_проверки": {
      "type": "object",
      "additionalProperties": false,
      "required": ["идентификатор", "хэш", "исход"],
      "properties": {
        "идентификатор": { "$ref": "#/$defs/идентификатор" },
        "хэш": { "$ref": "#/$defs/хэш" },
        "исход": { "enum": ["успешно", "неуспешно"] }
      }
    },
    "замороженный_результат": {
      "type": "object",
      "additionalProperties": false,
      "required": ["сторона", "идентификатор_fork", "состояние"],
      "properties": {
        "сторона": { "enum": ["левая", "правая"] },
        "идентификатор_fork": { "$ref": "#/$defs/идентификатор" },
        "состояние": { "enum": ["отсутствует", "заморожен"] },
        "идентификатор_результата": { "$ref": "#/$defs/идентификатор" },
        "хэш_результата": { "$ref": "#/$defs/хэш" },
        "идентификатор_репозитория": { "$ref": "#/$defs/идентификатор" },
        "база": { "$ref": "#/$defs/git_объект" },
        "вершина": { "$ref": "#/$defs/git_объект" },
        "диапазон": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/git_объект" }
        },
        "ссылка_результата": { "$ref": "#/$defs/рабочая_ссылка" },
        "хэш_назначения": { "$ref": "#/$defs/хэш" },
        "хэш_критериев": { "$ref": "#/$defs/хэш" },
        "хэши_паспортов_шагов": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/хэш" }
        },
        "проверки": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/свидетельство_проверки" }
        },
        "расход_бюджета": { "$ref": "#/$defs/бюджет" },
        "хэш_замораживания": { "$ref": "#/$defs/хэш" }
      },
      "oneOf": [
        {
          "properties": { "состояние": { "const": "отсутствует" } },
          "not": {
            "anyOf": [
              { "required": ["идентификатор_результата"] },
              { "required": ["хэш_результата"] },
              { "required": ["идентификатор_репозитория"] },
              { "required": ["база"] },
              { "required": ["вершина"] },
              { "required": ["диапазон"] },
              { "required": ["ссылка_результата"] },
              { "required": ["хэш_назначения"] },
              { "required": ["хэш_критериев"] },
              { "required": ["хэши_паспортов_шагов"] },
              { "required": ["проверки"] },
              { "required": ["расход_бюджета"] },
              { "required": ["хэш_замораживания"] }
            ]
          }
        },
        {
          "properties": { "состояние": { "const": "заморожен" } },
          "required": [
            "идентификатор_результата",
            "хэш_результата",
            "идентификатор_репозитория",
            "база",
            "вершина",
            "диапазон",
            "ссылка_результата",
            "хэш_назначения",
            "хэш_критериев",
            "хэши_паспортов_шагов",
            "проверки",
            "расход_бюджета",
            "хэш_замораживания"
          ]
        }
      ]
    },
    "состояние_модерации": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "идентификатор_попытки",
        "прежняя_host_сессия_сохранена",
        "родительский_FIFO_удерживается",
        "ссылки_с_правом_записи"
      ],
      "properties": {
        "идентификатор_попытки": { "$ref": "#/$defs/идентификатор" },
        "прежняя_host_сессия_сохранена": { "type": "boolean" },
        "родительский_FIFO_удерживается": { "type": "boolean" },
        "ссылки_с_правом_записи": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/рабочая_ссылка" }
        }
      }
    },
    "состояние_интеграции": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "идентификатор_интегратора",
        "идентификатор_целевого_репозитория",
        "целевая_ссылка",
        "ожидаемая_база",
        "предложенная_вершина",
        "состояние_сравнения_и_замены",
        "граф_отделён",
        "вложенный_результат_поднят",
        "хэш_поднятого_результата"
      ],
      "properties": {
        "идентификатор_интегратора": { "$ref": "#/$defs/необязательный_идентификатор" },
        "идентификатор_целевого_репозитория": { "$ref": "#/$defs/идентификатор" },
        "целевая_ссылка": { "$ref": "#/$defs/рабочая_ссылка" },
        "ожидаемая_база": { "$ref": "#/$defs/git_объект" },
        "предложенная_вершина": { "$ref": "#/$defs/необязательный_git_объект" },
        "состояние_сравнения_и_замены": {
          "enum": ["не_запрошено", "разрешено", "выполнено", "проиграно", "не_разрешено"]
        },
        "граф_отделён": { "type": "boolean" },
        "вложенный_результат_поднят": { "type": "boolean" },
        "хэш_поднятого_результата": { "$ref": "#/$defs/хэш" }
      }
    }
  }
}
