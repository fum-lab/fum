{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fum:%D0%BA%D0%BE%D0%BD%D0%B2%D0%B5%D1%80%D1%82-%D0%B7%D0%B0%D0%BF%D1%80%D0%BE%D1%81%D0%B0-%D1%81%D0%BB%D0%B8%D1%8F%D0%BD%D0%B8%D1%8F-%D1%86%D0%B5%D0%BF%D0%BE%D1%87%D0%BA%D0%B8:v1",
  "title": "Конверт запроса слияния цепочки v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "поставщик",
    "исходныйРепозиторий",
    "целевойРепозиторий",
    "каноническийПутьИсходногоРепозитория",
    "каноническийПутьЦелевогоРепозитория",
    "исходнаяСсылка",
    "целеваяСсылка",
    "идентификатор",
    "поколениеНазначения",
    "база",
    "вершина",
    "диапазон",
    "хэшПубликационногоАудита",
    "состояние",
    "числоСозданий",
    "числоАвторитетныхЧтений"
  ],
  "properties": {
    "поставщик": { "$ref": "#/$defs/идентификатор" },
    "исходныйРепозиторий": { "$ref": "#/$defs/идентификатор" },
    "целевойРепозиторий": { "$ref": "#/$defs/идентификатор" },
    "каноническийПутьИсходногоРепозитория": { "$ref": "#/$defs/каноническийПуть" },
    "каноническийПутьЦелевогоРепозитория": { "$ref": "#/$defs/каноническийПуть" },
    "исходнаяСсылка": { "$ref": "#/$defs/полнаяСсылка" },
    "целеваяСсылка": { "$ref": "#/$defs/полнаяСсылка" },
    "идентификатор": { "$ref": "#/$defs/идентификатор" },
    "поколениеНазначения": { "$ref": "#/$defs/идентификатор" },
    "база": { "$ref": "#/$defs/объектГит" },
    "вершина": { "$ref": "#/$defs/объектГит" },
    "диапазон": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/объектГит" }
    },
    "хэшПубликационногоАудита": { "$ref": "#/$defs/хэш" },
    "состояние": {
      "enum": [
        "подготовлен",
        "открыт",
        "закрыт",
        "переоткрыт",
        "принудительно_перезаписан",
        "база_сдвинута",
        "вершина_сдвинута",
        "исход_неизвестен"
      ]
    },
    "числоСозданий": { "type": "integer", "minimum": 0 },
    "числоАвторитетныхЧтений": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "идентификатор": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!\\u007E)(?!\\.{1,2}$)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*[\\\\/])[^\\u0000-\\u001F\\u007F\\s]{1,240}$"
    },
    "хэш": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "объектГит": {
      "type": "string",
      "oneOf": [
        { "pattern": "^[0-9a-f]{40}$" },
        { "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "полнаяСсылка": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^refs/(?!@$)(?!\\.)(?!.*[/]\\.)(?![^/]*\\.lock(?:/|$))(?!.*[/][^/]*\\.lock(?:/|$))(?!.*\\.\\.)(?!.*@\\{)(?!.*[\\u0000-\\u0020\\u007F\\u007E^:?*\\[\\\\])(?!.*\\.$)[^/]+(?:/[^/]+)+$"
    },
    "каноническийПуть": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001F\\u007F])[^/]+(?:/[^/]+)*$"
    }
  }
}
