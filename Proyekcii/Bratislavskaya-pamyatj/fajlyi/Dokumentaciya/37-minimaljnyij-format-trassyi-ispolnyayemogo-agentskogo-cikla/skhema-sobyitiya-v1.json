{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fum:agent-cycle-trace:event:v1",
  "title": "Событие минимальной трассы агентского цикла FUM версии 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "seq",
    "kind",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "task",
        "observation",
        "action",
        "check",
        "result",
        "error",
        "continuation"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/task"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "observation"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "action"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "check"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "continuation"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/continuation"
          }
        }
      }
    }
  ],
  "$defs": {
    "refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "acceptance",
        "source_refs",
        "allowed_actions",
        "model_step"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_refs": {
          "$ref": "#/$defs/refs",
          "minItems": 1
        },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/allowed_action"
          }
        },
        "model_step": {
          "$ref": "#/$defs/model_step"
        }
      }
    },
    "allowed_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "adapter",
        "effect"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "enum": [
            "read",
            "local_write",
            "local_execute"
          ]
        }
      }
    },
    "model_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "stub",
            "provider"
          ]
        },
        "provider_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "none"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "provider_ref"
              ]
            }
          },
          "else": {
            "required": [
              "provider_ref"
            ]
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "evidence_refs"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/refs",
          "minItems": 1
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "adapter",
        "effect",
        "summary",
        "target_refs",
        "authorization"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "enum": [
            "read",
            "local_write",
            "local_execute"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "target_refs": {
          "$ref": "#/$defs/refs",
          "minItems": 1
        },
        "authorization": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_seq",
        "status",
        "summary",
        "evidence_refs"
      ],
      "properties": {
        "subject_seq": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/refs",
          "minItems": 1
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_seq",
        "status",
        "summary",
        "artifact_refs"
      ],
      "properties": {
        "action_seq": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "success",
            "partial",
            "failed"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "artifact_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_seq",
        "code",
        "summary",
        "source",
        "retryable",
        "evidence_refs"
      ],
      "properties": {
        "action_seq": {
          "type": "integer",
          "minimum": 1
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "evidence_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "basis_seqs"
      ],
      "properties": {
        "status": {
          "enum": [
            "continue",
            "completed",
            "blocked",
            "awaiting_confirmation",
            "handed_off",
            "stopped",
            "failed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "basis_seqs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
