{
  "схема": "fum.определение-оператора.1",
  "идентификатор": "fum.arkhitektura.continuation-boundary.v2",
  "версия": 2,
  "правила": [],
  "шаги": [
    {
      "идентификатор": "решить-границу-приёмки-и-эффекта",
      "оператор": "вычислить-JSON",
      "аргументы": {
        "граф": {
          "схема": "fuma.граф-JSON.1",
          "числа": "целые64-без-дробей",
          "переменные": [
            {"имя":"memory_ready","значение":["путь",["переменная","вход"],"restore","memory_ready"]},
            {"имя":"read_scope","значение":["путь",["переменная","вход"],"scope","read_only_work_eligible"]},
            {"имя":"write_scope","значение":["путь",["переменная","вход"],"scope","write_scope_eligible"]},
            {"имя":"writer_binding","значение":["путь",["переменная","вход"],"live_binding","writer"]},
            {"имя":"access","значение":["путь",["переменная","вход"],"next_action","access"]},
            {"имя":"dependency","значение":["путь",["переменная","вход"],"next_action","dependency"]},
            {"имя":"root_boundary","значение":["путь",["переменная","вход"],"next_action","requires_root_acceptance"]},
            {"имя":"peer_acceptance","значение":["путь",["переменная","вход"],"peer_result","acceptance"]},
            {"имя":"model_selected","значение":["путь",["переменная","вход"],"model","selected"]},
            {"имя":"model_runtime_observed","значение":["путь",["переменная","вход"],"model","runtime_observed"]},
            {"имя":"model_runtime_state","значение":["путь",["переменная","вход"],"model","runtime_state"]},
            {"имя":"model_runtime_required","значение":["путь",["переменная","вход"],"model","required_for_action"]},
            {
              "имя":"dependency_kind",
              "значение":[
                "если",
                ["равно",["переменная","dependency"],"independent"],
                "independent",
                ["если",["равно",["переменная","dependency"],"peer-output"],"peer-output","unknown"]
              ]
            },
            {
              "имя":"peer_status",
              "значение":[
                "если",
                ["равно",["переменная","peer_acceptance"],"accepted"],
                "accepted",
                ["если",["равно",["переменная","peer_acceptance"],"pending"],"pending","unknown"]
              ]
            },
            {
              "имя":"acceptance_gate",
              "значение":[
                "если",
                ["равно",["переменная","root_boundary"],["истина"]],
                "await-root-acceptance",
                [
                  "если",
                  ["равно",["переменная","dependency_kind"],"unknown"],
                  "classify-dependency",
                  [
                    "если",
                    ["равно",["переменная","dependency_kind"],"independent"],
                    "ready",
                    [
                      "если",
                      ["равно",["переменная","peer_status"],"accepted"],
                      "ready",
                      ["если",["равно",["переменная","peer_status"],"pending"],"await-direct-parent-acceptance","verify-direct-parent-acceptance"]
                    ]
                  ]
                ]
              ]
            },
            {
              "имя":"model_gate",
              "значение":[
                "если",
                ["равно",["переменная","model_runtime_required"],["истина"]],
                ["если",["равно",["переменная","model_runtime_state"],"available"],"ready","await-required-model-runtime"],
                "ready"
              ]
            },
            {
              "имя":"read_action_decision",
              "значение":[
                "если",
                ["равно",["переменная","memory_ready"],["истина"]],
                [
                  "если",
                  ["равно",["переменная","read_scope"],["истина"]],
                  ["если",["равно",["переменная","dependency_kind"],"independent"],"continue-independent-read-only","continue-after-direct-parent-acceptance-read-only"],
                  "read-scope-not-eligible"
                ],
                "memory-recovery-not-ready"
              ]
            },
            {
              "имя":"effect_action_decision",
              "значение":[
                "если",
                ["равно",["переменная","write_scope"],["истина"]],
                [
                  "если",
                  ["равно",["переменная","writer_binding"],"fresh-bound"],
                  ["если",["равно",["переменная","dependency_kind"],"independent"],"continue-independent-effect","continue-after-direct-parent-acceptance-effect"],
                  "observe-live-writer-binding"
                ],
                "write-scope-not-eligible"
              ]
            },
            {
              "имя":"action_decision",
              "значение":[
                "если",
                ["равно",["переменная","model_gate"],"ready"],
                [
                  "если",
                  ["равно",["переменная","access"],"read-only"],
                  ["переменная","read_action_decision"],
                  ["если",["равно",["переменная","access"],"write-effect"],["переменная","effect_action_decision"],"classify-access"]
                ],
                ["переменная","model_gate"]
              ]
            },
            {
              "имя":"decision",
              "значение":[
                "если",
                ["равно",["переменная","acceptance_gate"],"ready"],
                ["переменная","action_decision"],
                ["переменная","acceptance_gate"]
              ]
            }
          ],
          "результат": {
            "contract":"fum.arkhitektura.continuation-boundary@2",
            "case_id":["путь",["переменная","вход"],"case_id"],
            "decision":["переменная","decision"],
            "acceptance_gate":["переменная","acceptance_gate"],
            "memory_recovery_ready":["переменная","memory_ready"],
            "read_only_work_available":["если",["равно",["переменная","memory_ready"],["истина"]],["переменная","read_scope"],["ложь"]],
            "logical_write_scope_eligible":["переменная","write_scope"],
            "live_writer_binding":["переменная","writer_binding"],
            "model_selected":["переменная","model_selected"],
            "model_runtime_observed":["переменная","model_runtime_observed"],
            "model_runtime_state":["переменная","model_runtime_state"],
            "model_runtime_required":["переменная","model_runtime_required"],
            "can_continue":[
              "если",
              ["равно",["переменная","decision"],"continue-independent-read-only"],["истина"],
              ["если",
                ["равно",["переменная","decision"],"continue-after-direct-parent-acceptance-read-only"],["истина"],
                ["если",
                  ["равно",["переменная","decision"],"continue-independent-effect"],["истина"],
                  ["равно",["переменная","decision"],"continue-after-direct-parent-acceptance-effect"]
                ]
              ]
            ],
            "can_continue_independently":[
              "если",
              ["равно",["переменная","decision"],"continue-independent-read-only"],["истина"],
              ["равно",["переменная","decision"],"continue-independent-effect"]
            ],
            "effect_allowed":[
              "если",
              ["равно",["переменная","decision"],"continue-independent-effect"],["истина"],
              ["равно",["переменная","decision"],"continue-after-direct-parent-acceptance-effect"]
            ],
            "acceptance_required_for_action":[
              "если",
              ["равно",["переменная","acceptance_gate"],"await-root-acceptance"],["истина"],
              ["если",
                ["равно",["переменная","acceptance_gate"],"await-direct-parent-acceptance"],["истина"],
                ["равно",["переменная","acceptance_gate"],"verify-direct-parent-acceptance"]
              ]
            ],
            "root_acceptance_required":["равно",["переменная","acceptance_gate"],"await-root-acceptance"]
          }
        }
      }
    }
  ]
}
