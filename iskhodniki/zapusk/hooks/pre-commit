#!/bin/sh
set -eu

# Явный ранее собранный fuma; сборка из произвольного dirty checkout здесь не запускается.
: "${FUM_SWIFT_LANGUAGE_GATE_BINARY:?Укажите абсолютный путь к проверенному бинарнику fuma}"
case "$FUM_SWIFT_LANGUAGE_GATE_BINARY" in /*) ;; *) exit 2 ;; esac
test -x "$FUM_SWIFT_LANGUAGE_GATE_BINARY" || exit 2
set -- "$(/usr/bin/git --no-optional-locks rev-parse --show-toplevel)"
exec "$FUM_SWIFT_LANGUAGE_GATE_BINARY" язык индекс --корень "$1"
