    "причина": "Разрешающий parser принял literal и escaped duplicate keys; тест реально исполнился и сохранил одну квитанцию",
    "исходник_до": "import Foundation\n\nstruct ОтказЦелостности: Error, Sendable {\n    let причина: String\n    let выход: Int32\n    let доказано: Bool\n}\nfunc проверитьJSON(_ данные: Data) throws {\n    _ = try JSONSerialization.jsonObject(with: данные)\n}\n",
    "тест_до": "import Foundation\nimport Testing\n@testable import Целостность\n\nprivate func квитанция(_ случай: String) throws {\n    let каталог = try #require(ProcessInfo.processInfo.environment[\"ФУМ_КВИТАНЦИИ\"])\n    var данные = try JSONSerialization.data(withJSONObject: [\n        \"схема\": \"fum.квитанция-проверки.1\", \"случай\": случай, \"состояние\": \"завершён\"\n    ], options: [.prettyPrinted, .sortedKeys])\n    данные.append(10)\n    try данные.write(to: URL(fileURLWithPath: каталог).appendingPathComponent(случай + \".json\"), options: .withoutOverwriting)\n}\n@Suite(.serialized)\nstruct ПроверкиЦелостности {\n    @Test func дублиКлючей() throws {\n        let путь = try #require(Bundle.module.url(forResource: \"состав-14\", withExtension: \"json\"))\n        let данные = try Data(contentsOf: путь)\n        try проверитьJSON(данные)\n        for текст in [\n            \"{\\\"ключ\\\": 1, \\\"ключ\\\": 2}\\n\",\n            \"{\\\"ключ\\\": 1, \\\"\\\\u043aлюч\\\": 2}\\n\"\n        ] {\n            do {\n                try проверитьJSON(Data(текст.utf8))\n                Issue.record(\"Дубли ключей приняты\")\n            } catch let ошибка as ОтказЦелостности {\n                #expect(ошибка.причина == \"ключи\")\n                #expect(ошибка.выход == 1)\n            } catch { Issue.record(\"Неверный тип адресного отказа\") }\n        }\n        try квитанция(\"дубли\")\n    }\n}\n"
  },
