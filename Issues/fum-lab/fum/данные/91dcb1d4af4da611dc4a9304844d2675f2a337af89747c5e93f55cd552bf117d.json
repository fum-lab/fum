her_user}","gists_url":"https://api.github.com/users/Roman-Kerimov/gists{/gist_id}","starred_url":"https://api.github.com/users/Roman-Kerimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Roman-Kerimov/subscriptions","organizations_url":"https://api.github.com/users/Roman-Kerimov/orgs","repos_url":"https://api.github.com/users/Roman-Kerimov/repos","events_url":"https://api.github.com/users/Roman-Kerimov/events{/privacy}","received_events_url":"https://api.github.com/users/Roman-Kerimov/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":1,"created_at":"2026-10-08T16:47:48Z","updated_at":"2026-10-24T15:20:02Z","closed_at":"2026-10-24T15:20:02Z","assignee":{"login":"Roman-Kerimov","id":22149544,"node_id":"MDQ6VXNlcjIyMTQ5NTQ0","avatar_url":"https://avatars.githubusercontent.com/u/22149544?v=4","gravatar_id":"","url":"https://api.github.com/users/Roman-Kerimov","html_url":"https://github.com/Roman-Kerimov","followers_url":"https://api.github.com/users/Roman-Kerimov/followers","following_url":"https://api.github.com/users/Roman-Kerimov/following{/other_user}","gists_url":"https://api.github.com/users/Roman-Kerimov/gists{/gist_id}","starred_url":"https://api.github.com/users/Roman-Kerimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Roman-Kerimov/subscriptions","organizations_url":"https://api.github.com/users/Roman-Kerimov/orgs","repos_url":"https://api.github.com/users/Roman-Kerimov/repos","events_url":"https://api.github.com/users/Roman-Kerimov/events{/privacy}","received_events_url":"https://api.github.com/users/Roman-Kerimov/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**FUM Codex**\n\nПри подготовке обратной доставки принятого среза найдено несоответствие контрактов: создатель обычной контрольной точки .7 допускает родителей [HEAD,S], но ordinary-генератор отклоняет MERGE_HEAD. Квитанция обратной доставки после apply разрешает только terminal JSON и свой блок отчёта; новая папка Журнала, история модели, RAW и навигация нарушают сохранённое дерево. Одно расширение ACT этого не исправляет.\n\nНужна поддержанная композиция обычной контрольной точки и обратной доставки:\n- Явно определить допустимые служебные изменения, сохранив защищённые файлы, точных родителей, происхождение и индекс.\n- Проверить сквозной путь .7 → .9 → merge-коммит → наблюдение доставки, включая прерывание, повтор и дрейф.\n- Сохранить RED/GREEN, сопоставимый профиль, команды воспроизведения и честную границу между тестовым и живым применением.\n\nПриоритет — восстановление исполнителей и интеграция. До следующей попытки такого сочетания требуется проверенная реализация; ручной обход не является результатом. Это обнаруженный чтением пробел совместимости, а не заявленный неуспешный живой merge.\n\n[Постановка в точном коммите e36b4171](https://github.com/fum-lab/fum/blob/e36b417166f22856e8e6679eb52a6c388ef7ef0c/%D0%9F%D0%BB%D0%B0%D0%BD%D0%B8%D1%80%D0%BE%D0%B2%D0%B0%D0%BD%D0%B8%D0%B5/%D0%BF%D0%B0%D1%80%D0%B0%D0%BB%D0%BB%D0%B5%D0%BB%D1%8C%D0%BD%D1%8B%D0%B5-%D0%BF%D0%BE%D1%81%D1%82%D0%B0%D0%BD%D0%BE%D0%B2%D0%BA%D0%B8/2026-10-08/%D1%81%D0%BE%D0%B3%D0%BB%D0%B0%D1%81%D0%BE%D0%B2%D0%B0%D1%82%D1%8C-%D0%BE%D0%B1%D1%80%D0%B0%D1%82%D0%BD%D1%83%D1%8E-%D0%B4%D0%BE%D1%81%D1%82%D0%B0%D0%B2%D0%BA%D1%83-%D0%B8-%D0%BA%D0%BE%D0%BD%D1%82%D1%80%D0%BE%D0%BB%D1%8C%D0%BD%D1%83%D1%8E-%D1%82%D0%BE%D1%87%D0%BA%D1%83.md)\n\nОтдельно от #217: там читающая сверка уже готовой контрольной точки и доставки, здесь совместимость создания merge-контрольной точки с обратной доставкой.","closed_by":{"login":"Roman-Kerimov","id":22149544,"node_id":"MDQ6VXNlcjIyMTQ5NTQ0","avatar_url":"https://avatars.githubusercontent.com/u/22149544?v=4","gravatar_id":"","url":"https://api.github.com/users/Roman-Kerimov","html_url":"https://github.com/Roman-Kerimov","followers_url":"https://api.github.com/users/Roman-Kerimov/followers","following_url":"https://api.github.com/users/Roman-Kerimov/following{/other_user}","gists_url":"https://api.github.com/users/Roman-Kerimov/gists{/gist_id}","starred_url":"https://api.github.com/users/Roman-Kerimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Roman-Kerimov/subscriptions","organizations_url":"https://api.github.com/users/Roman-Kerimov/orgs","repos_url":"https://api.github.com/users/Roman-Kerimov/repos","events_url":"https://api.github.com/users/Roman-Kerimov/events{/privacy}","received_events_url":"https://api.github.com/users/Roman-Kerimov/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/fum-lab/fum/issues/231/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/fum-lab/fum/issues/231/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}