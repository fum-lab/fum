r_user}","gists_url":"https://api.github.com/users/Roman-Kerimov/gists{/gist_id}","starred_url":"https://api.github.com/users/Roman-Kerimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Roman-Kerimov/subscriptions","organizations_url":"https://api.github.com/users/Roman-Kerimov/orgs","repos_url":"https://api.github.com/users/Roman-Kerimov/repos","events_url":"https://api.github.com/users/Roman-Kerimov/events{/privacy}","received_events_url":"https://api.github.com/users/Roman-Kerimov/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2026-10-05T18:55:54Z","updated_at":"2026-10-05T18:55:55Z","closed_at":null,"assignee":{"login":"Roman-Kerimov","id":22149544,"node_id":"MDQ6VXNlcjIyMTQ5NTQ0","avatar_url":"https://avatars.githubusercontent.com/u/22149544?v=4","gravatar_id":"","url":"https://api.github.com/users/Roman-Kerimov","html_url":"https://github.com/Roman-Kerimov","followers_url":"https://api.github.com/users/Roman-Kerimov/followers","following_url":"https://api.github.com/users/Roman-Kerimov/following{/other_user}","gists_url":"https://api.github.com/users/Roman-Kerimov/gists{/gist_id}","starred_url":"https://api.github.com/users/Roman-Kerimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Roman-Kerimov/subscriptions","organizations_url":"https://api.github.com/users/Roman-Kerimov/orgs","repos_url":"https://api.github.com/users/Roman-Kerimov/repos","events_url":"https://api.github.com/users/Roman-Kerimov/events{/privacy}","received_events_url":"https://api.github.com/users/Roman-Kerimov/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**FUM Codex**\n\nПри приёмке PR №212 адресная публикационная проверка обнаружила пять строк открытых фикстур вне точной политики. Сам дочерний create `.7` уже завершился и был опубликован. Merge edabf43260b47c0ec3b0c8d7726e0c6fa37722c6 сохранил исходники и закрытые свидетельства и добавил только пять точных деклараций.\n\nПричина: генератор проверяет публикационную чистоту создаваемой пары Журнала и постановки/ACT, а не всех конечных индексных байтов `.7`. Проверки ready/create сверяют назначенные успешные UUID, индекс и связность, но не добавляют обязательное публикационное сканирование.\n\nНужно обязательное адресное сканирование всего точного конечного состава `.7`, включая собственные материалы Журнала, до ready/create и Git-эффекта. Закрепить сканер, политику и входные байты; произвольный успешный UUID или чистая стартовая пара не заменяют этот допуск.\n\nПриёмка: чистая стартовая пара и запрещённая форма в новом предметном файле должны дать отказ до Git-эффекта; одна точная policy-декларация разрешает тот же состав. Проверить дрейф индекса/политики между допуском и эффектом. Требуются RED/GREEN и адресный профиль; полный smoke не нужен для доказательства этой границы.\n\nЗадача зарегистрирована. Реализацию запускать отдельным конечным поручением после освобождения области двух фасадов от задачи переноса модели; до того конкретным исполнителям явно проверять публикационную чистоту своего полного состава. Автоматизация остаётся незавершённой.\n\n<!-- FUM-DEFECT: publication-final-child-scope-2026-10-05 -->\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/fum-lab/fum/issues/213/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/fum-lab/fum/issues/213/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}