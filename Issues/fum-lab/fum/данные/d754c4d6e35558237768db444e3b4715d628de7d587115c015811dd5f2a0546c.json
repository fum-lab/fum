llowing{/other_user}","gists_url":"https://api.github.com/users/Roman-Kerimov/gists{/gist_id}","starred_url":"https://api.github.com/users/Roman-Kerimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Roman-Kerimov/subscriptions","organizations_url":"https://api.github.com/users/Roman-Kerimov/orgs","repos_url":"https://api.github.com/users/Roman-Kerimov/repos","events_url":"https://api.github.com/users/Roman-Kerimov/events{/privacy}","received_events_url":"https://api.github.com/users/Roman-Kerimov/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":2,"created_at":"2026-10-13T23:32:12Z","updated_at":"2026-10-24T15:39:04Z","closed_at":"2026-10-24T15:39:04Z","assignee":{"login":"Roman-Kerimov","id":22149544,"node_id":"MDQ6VXNlcjIyMTQ5NTQ0","avatar_url":"https://avatars.githubusercontent.com/u/22149544?v=4","gravatar_id":"","url":"https://api.github.com/users/Roman-Kerimov","html_url":"https://github.com/Roman-Kerimov","followers_url":"https://api.github.com/users/Roman-Kerimov/followers","following_url":"https://api.github.com/users/Roman-Kerimov/following{/other_user}","gists_url":"https://api.github.com/users/Roman-Kerimov/gists{/gist_id}","starred_url":"https://api.github.com/users/Roman-Kerimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Roman-Kerimov/subscriptions","organizations_url":"https://api.github.com/users/Roman-Kerimov/orgs","repos_url":"https://api.github.com/users/Roman-Kerimov/repos","events_url":"https://api.github.com/users/Roman-Kerimov/events{/privacy}","received_events_url":"https://api.github.com/users/Roman-Kerimov/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**FUM Codex**\n\nПри подключении независимого Журнала кандидат меняет Creator, READY и coherence. Для собственной контрольной точки он должен исполнять уже принятый код из неизменного Git-снимка K. Существующие ordinary API есть, но единственный production bootstrap ограничен писателем состояния U/G2; prepare/ready/create обычного дочернего .7/.9 он не поддерживает.\n\nНужен отдельный ограниченный consumer на основе принятого механизма захвата кода и Контур.исполнить: независимые K, конечный manifest, точный ACT и вход; свежий процесс -I -S -B; кандидат W только как данные. Сохранить guards перед файловыми эффектами и flock, закрытый Popen, recency callback из K, защиту приватных выходов и повтор квитанции без нового эффекта. Кандидат не принимает свой bootstrap.\n\nПредлагаемый объём — два новых сценария launcher/entry, адресные тесты, отдельный профиль и руководство. Прежние state launcher/entry, engine, Creator, нормы и runtime не изменяются этим сегментом. TDD должен доказать отказ на изменённые K/manifest/ACT, исполняемый код W и обход проверки через subprocess/recency/отложенную запись. Профиль — три свежих процесса одного закреплённого сценария; сохранённые проверки и поколение READY не сбрасываются.\n\nСвязь: [независимый Журнал, PR254](https://github.com/fum-lab/fum/pull/254), [Issue252](https://github.com/fum-lab/fum/issues/252). Сначала принимается consumer, затем ему доверяется контрольная поставка Журнала; само это обращение не объявляет bootstrap работающим.\n","closed_by":{"login":"Roman-Kerimov","id":22149544,"node_id":"MDQ6VXNlcjIyMTQ5NTQ0","avatar_url":"https://avatars.githubusercontent.com/u/22149544?v=4","gravatar_id":"","url":"https://api.github.com/users/Roman-Kerimov","html_url":"https://github.com/Roman-Kerimov","followers_url":"https://api.github.com/users/Roman-Kerimov/followers","following_url":"https://api.github.com/users/Roman-Kerimov/following{/other_user}","gists_url":"https://api.github.com/users/Roman-Kerimov/gists{/gist_id}","starred_url":"https://api.github.com/users/Roman-Kerimov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Roman-Kerimov/subscriptions","organizations_url":"https://api.github.com/users/Roman-Kerimov/orgs","repos_url":"https://api.github.com/users/Roman-Kerimov/repos","events_url":"https://api.github.com/users/Roman-Kerimov/events{/privacy}","received_events_url":"https://api.github.com/users/Roman-Kerimov/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/fum-lab/fum/issues/257/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/fum-lab/fum/issues/257/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}